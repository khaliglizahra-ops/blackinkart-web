# Black Ink Art — ortam değişkenleri (örnek). Gerçek değerleri .env dosyasına
# (yerelde) ya da GitHub → Settings → Secrets and variables → Actions →
# "Variables" bölümüne yazın; .env depoya girmez.
#
# Google Analytics 4 ölçüm kimliği (ör. G-ABC123XYZ). BOŞSA analitik kodu hiç
# yüklenmez ve çerez onayındaki "Analitik" seçeneği "şu an kullanılmıyor" görünür.
GA_MEASUREMENT_ID=
#
# Google Tag Manager kapsayıcı kimliği (ör. GTM-ABC1234). Doluysa GA4 doğrudan
# değil Tag Manager üzerinden yüklenir (çift sayımı önlemek için ikisi birlikte
# doluysa yalnızca GTM kullanılır).
GTM_ID=
