---
import GuideHero from './GuideHero.astro';
import { useTranslations } from '../i18n/ui';
import { langFromPath, localizePath, LANG_LABELS } from '../i18n/config';

interface Props {
  hubLabel: string;
  hubHref: string;
  title: string;
  updatedAt: string;
  heroImage?: string;
  heroArt?: 'flow' | 'radiate' | 'steps' | 'waves' | 'bodymap' | 'ornament' | 'scatter' | 'lattice';
  heroSeed?: number;
  prev?: { title: string; href: string } | null;
  next?: { title: string; href: string } | null;
}

const { hubLabel, hubHref, title, updatedAt, heroImage, heroArt, heroSeed, prev, next } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const t = useTranslations(lang);
const updatedLabel = new Date(updatedAt).toLocaleDateString(LANG_LABELS[lang].htmlLang === 'en' ? 'en-GB' : 'tr-TR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<article class="guide">
  <GuideHero
    eyebrow={hubLabel}
    title={title}
    breadcrumbs={[{ label: hubLabel, href: hubHref }, { label: title }]}
    image={heroImage}
    art={heroArt}
    seed={heroSeed}
  />
  <div class="container narrow section-tight">
    <p class="updated">{t('guide.updated')}: {updatedLabel}</p>
    <div class="gold-rule"></div>
    <div class="prose" data-reveal>
      <slot />
    </div>

    {(prev || next) && (
      <nav class="pager" aria-label={t('guide.pagerLabel')}>
        {prev ? <a href={prev.href} class="pager-link prev"><span>{t('guide.prev')}</span>{prev.title}</a> : <span />}
        {next ? <a href={next.href} class="pager-link next"><span>{t('guide.next')}</span>{next.title}</a> : <span />}
      </nav>
    )}

    <div class="cta surface" data-reveal>
      <div>
        <h2>{t('guide.ctaTitle')}</h2>
        <p>{t('guide.ctaText')}</p>
      </div>
      <div class="cta-actions">
        <a href={localizePath('/randevu', lang)} class="btn btn-primary">{t('cta.book')}</a>
        <a href={localizePath('/hakkimizda-iletisim', lang)} class="btn btn-outline">{t('cta.contact')}</a>
      </div>
    </div>
  </div>
</article>

<style>
  .narrow {
    max-width: 760px;
  }

  .updated {
    font-size: 0.8rem;
    color: var(--color-ivory-faint);
    margin-bottom: 0;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 3rem 0 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-hairline);
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.3em;
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--color-ivory);
    transition: color var(--dur-fast);
  }

  .pager-link span {
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .pager-link.next {
    text-align: right;
    align-items: flex-end;
  }

  .pager-link:hover {
    color: var(--color-gold-bright);
  }

  .cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding: 2rem;
    margin-top: 2rem;
  }

  .cta h2 {
    margin-bottom: 0.3em;
  }

  .cta p {
    margin: 0;
  }

  .cta-actions {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  @media (max-width: 560px) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pager-link.next {
      text-align: left;
      align-items: flex-start;
    }
  }
</style>
