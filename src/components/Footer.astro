---
import { site } from '../data/site';
import { getNav, getLegalNav } from '../i18n/nav';
import { useTranslations } from '../i18n/ui';
import { langFromPath, localizePath } from '../i18n/config';

const year = new Date().getFullYear();
const lang = langFromPath(Astro.url.pathname);
const t = useTranslations(lang);
const nav = getNav(lang);
const legalNav = getLegalNav(lang);
---

<footer class="site-footer">
  <div class="container grid">
    <div class="col-brand">
      <img src="/brand/logo-mark.png" alt={site.shortName} width="200" height="93" class="footer-logo" />
      <p>{lang === 'en' && (site as any).taglineEn ? (site as any).taglineEn : site.tagline}.</p>
      <p class="addr">{site.address.full}</p>

      {/* Harita: `loading="lazy"` ile yalnızca altbilgi görünürken yükleniyor —
          her sayfaya gömülü bir Google haritası, peşin yüklenirse açılışı
          yavaşlatıyor. Tıklanınca tam haritayı yeni sekmede açıyor. */}
      <a
        class="footer-map"
        href={(site as any).mapsUrl ?? site.mapsEmbedSrc}
        target="_blank"
        rel="noopener"
        aria-label={t('footer.mapAria')}
      >
        <iframe
          src={site.mapsEmbedSrc}
          title={t('footer.mapTitle')}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          tabindex="-1"
        ></iframe>
        <span class="footer-map-cta">{t('footer.directions')}</span>
      </a>
    </div>

    <div class="col">
      <h2>{t('footer.explore')}</h2>
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>

    <div class="col">
      <h2>{t('footer.contact')}</h2>
      <ul>
        <li><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a></li>
        <li><a href={site.instagram.url} target="_blank" rel="noopener">{site.instagram.handle}</a></li>
      </ul>
    </div>

    <div class="col">
      <h2>{t('footer.other')}</h2>
      <ul>
        <li><a href={site.jewelryShopUrl} target="_blank" rel="noopener">{t('footer.jewelryShop')}</a></li>
        {legalNav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>
  </div>

  <div class="container bottom">
    <p>© {year} {site.name}. {t('footer.rights')}</p>
    <p class="made-by">
      {t('footer.ageNote')}
      <a href={localizePath('/yas-ve-onam-politikasi', lang)}>{t('footer.ageDetails')}</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-ink-950);
    border-top: 1px solid var(--color-hairline);
    padding-block: clamp(3rem, 6vw, 5rem) 2rem;
  }

  .grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
  }

  .footer-logo {
    height: 40px;
    width: auto;
    margin-bottom: 1rem;
  }

  .col-brand p {
    max-width: 34ch;
    font-size: 0.88rem;
  }

  .addr {
    color: var(--color-ivory-faint);
  }

  .footer-map {
    display: block;
    position: relative;
    margin-top: 1rem;
    max-width: 320px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm);
    overflow: hidden;
    transition: border-color var(--dur-fast);
  }

  .footer-map:hover {
    border-color: var(--color-gold-35);
  }

  .footer-map iframe {
    display: block;
    width: 100%;
    height: 150px;
    border: 0;
    /* Google'ın açık renkli haritası koyu altbilgide göz alıyordu. */
    filter: grayscale(0.5) invert(0.92) hue-rotate(180deg) brightness(0.95) contrast(0.9);
    /* Kartın tamamı bir bağlantı; iframe'in kendi kaydırması araya girmesin. */
    pointer-events: none;
  }

  .footer-map-cta {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.5em 0.8em;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-gold);
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.85) 45%);
  }

  /* Görsel olarak küçük bir etiket ama belge yapısında h2 — h4 kullanılınca her
     sayfada h2'den h4'e atlama oluşuyordu. Boyut zaten burada belirleniyor. */
  .col h2 {
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 1.1rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  ul a {
    font-size: 0.88rem;
    color: var(--color-ivory-dim);
    transition: color var(--dur-fast);
  }

  ul a:hover {
    color: var(--color-gold);
  }

  .bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-hairline);
    font-size: 0.78rem;
    color: var(--color-ivory-faint);
  }

  .made-by {
    max-width: 62ch;
  }

  .made-by a {
    color: var(--color-gold);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .bottom p {
    margin: 0;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .col-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
