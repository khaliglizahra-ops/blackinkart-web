---
import { langFromPath, localizePath } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

const lang = langFromPath(Astro.url.pathname);
// Çalışma saatleri panelde Türkçe giriliyor; `dayEn`/`hoursEn` varsa İngilizce sayfada o kullanılıyor.
const hDay = (h: any) => (lang === 'en' && h.dayEn ? h.dayEn : h.day);
const hHours = (h: any) => (lang === 'en' && h.hoursEn ? h.hoursEn : h.hours);
const t = useTranslations(lang);
const L = (p: string) => localizePath(p, lang);

// Mesaj metinleri betiğe veri olarak geçiyor: betik <script> içinde çalıştığı
// için t() oraya doğrudan giremiyor.
const M = {
  hello: t('booking.msg.hello'),
  service: t('booking.msg.service'),
  count: t('booking.msg.count'),
  note: t('booking.msg.note'),
  style: t('booking.msg.style'),
  design: t('booking.msg.design'),
  area: t('booking.msg.area'),
  size: t('booking.msg.size'),
  firstTattoo: t('booking.msg.firstTattoo'),
  day: t('booking.msg.day'),
  time: t('booking.msg.time'),
  name: t('booking.msg.name'),
  age: t('booking.msg.age'),
  extra: t('booking.msg.extra'),
  from: t('booking.msg.from'),
  together: t('booking.msg.together'),
  unspecified: t('booking.msg.unspecified'),
  anyTime: t('booking.anyTime'),
  tattoo: t('booking.tattoo'),
  piercing: t('booking.piercingType'),
};
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { site } from '../../data/site';
import { getLocalizedCollection } from '../../i18n/content';
import portfolio from '../../data/portfolio.json';

/**
 * Randevu talebi — takvim değil, WhatsApp'a giden yapılandırılmış bir form.
 *
 * Ziyaretçi ne istediğini seçiyor, form bunu düzgün bir mesaja çeviriyor ve
 * kendi WhatsApp'ında açıyor; gönderdiğinde stüdyoya tek mesajda her şey
 * ulaşıyor. Saati stüdyo belirliyor, yani burada "boş saat" göstermek gerekmiyor
 * — zaten göstermek için bir takvim sunucusu, hesap ve aylık ücret gerekirdi.
 * Site tamamen statik olduğu için bu akış hiçbir arka uç gerektirmiyor.
 */
// Bölge listesi ziyaretçinin dilinde gelsin: İngilizce formda "Ear Piercings",
// Türkçede "Kulak Piercingleri". Mesaj da o dilde gidiyor.
const areas = (await getLocalizedCollection('piercing-bolgeleri', lang)).map((e) => e.data.title);

const styles = portfolio.categories.map((c: any) => (lang === 'en' && c.labelEn ? c.labelEn : c.label));
---

<BaseLayout
  title={t('booking.title')}
  description={t('booking.pageDesc')}
  path={L('/randevu')}
>
  <section class="section-tight">
    <div class="container narrow">
      <Breadcrumbs items={[{ label: t('booking.eyebrow') }]} />
      <p class="eyebrow">{t('booking.eyebrow')}</p>
      <h1>{t('booking.h1')}</h1>
      <p class="lead">
        {t('booking.lead')}
      </p>

      <ol class="steps">
        <li><span>1</span> {t('booking.step1')}</li>
        <li><span>2</span> {t('booking.step2')}</li>
        <li><span>3</span> {t('booking.step3')}</li>
      </ol>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="booking-layout">
        <form class="request surface" id="randevu-form" novalidate>
          <fieldset class="block">
            <legend>{t('booking.legend1')}</legend>
            <div class="choice-row">
              <label class="choice">
                <input type="radio" name="tur" value="Dövme" checked />
                <span>{t('booking.tattoo')}</span>
              </label>
              <label class="choice">
                <input type="radio" name="tur" value="Piercing" />
                <span>{t('booking.piercingType')}</span>
              </label>
            </div>
          </fieldset>

          <!-- Dövme alanları -->
          <fieldset class="block" data-group="Dövme">
            <legend>{t('booking.legend2t')}</legend>

            <label class="field">
              <span class="label">{t('booking.style')}</span>
              <select name="stil">
                <option value="">{t('booking.unsure')}</option>
                {styles.map((s) => <option value={s}>{s}</option>)}
              </select>
            </label>

            <label class="field">
              <span class="label">{t('booking.design')}</span>
              <textarea
                name="tasarim"
                rows="3"
                placeholder={t('booking.ph.design')}
              ></textarea>
            </label>

            <div class="field-row">
              <label class="field">
                <span class="label">{t('booking.bodyArea')}</span>
                <input type="text" name="dovme_bolge" placeholder={t('booking.ph.area')} />
              </label>
              <label class="field">
                <span class="label">{t('booking.size')}</span>
                <input type="text" name="boyut" placeholder={t('booking.ph.size')} />
              </label>
            </div>

            <div class="choice-row tight">
              <span class="label">{t('booking.first')}</span>
              <label class="choice sm"><input type="radio" name="ilk" value={t('booking.yes')} /><span>{t('booking.yes')}</span></label>
              <label class="choice sm"><input type="radio" name="ilk" value={t('booking.no')} /><span>{t('booking.no')}</span></label>
            </div>
          </fieldset>

          <!-- Piercing alanları -->
          <fieldset class="block" data-group="Piercing" hidden>
            <legend>{t('booking.legend2p')}</legend>

            <div class="field-row">
              <label class="field">
                <span class="label">{t('booking.placement')}</span>
                <select name="piercing_bolge">
                  <option value="">{t('booking.unsure')}</option>
                  {areas.map((a) => <option value={a}>{a}</option>)}
                </select>
              </label>
              <label class="field narrow-field">
                <span class="label">{t('booking.count')}</span>
                <input type="number" name="adet" min="1" max="10" value="1" />
              </label>
            </div>

            <label class="field">
              <span class="label">{t('booking.anythingElse')}</span>
              <textarea
                name="piercing_not"
                rows="2"
                placeholder={t('booking.ph.pnote')}
              ></textarea>
            </label>
          </fieldset>

          <fieldset class="block">
            <legend>{t('booking.legend3')}</legend>
            <p class="note">
              {t('booking.timeNote')}
            </p>

            <div class="field-row">
              <label class="field">
                <span class="label">{t('booking.day')}</span>
                <input type="date" name="gun" id="gun" />
              </label>
              <label class="field">
                <span class="label">{t('booking.time')}</span>
                <select name="saat">
                  <option>{t('booking.anyTime')}</option>
                  <option>{t('booking.morning')}</option>
                  <option>{t('booking.afternoon')}</option>
                  <option>{t('booking.evening')}</option>
                </select>
              </label>
            </div>
            <p class="note hours-note">
              {site.hours.map((h) => <span>{hDay(h)}: {hHours(h)}</span>)}
            </p>
          </fieldset>

          <fieldset class="block">
            <legend>{t('booking.legend4')}</legend>

            <label class="field">
              <span class="label">{t('booking.name')} <em>*</em></span>
              <input type="text" name="ad" id="ad" required placeholder={t('booking.ph.name')} />
            </label>

            <label class="field">
              <span class="label">{t('booking.ageLabel')} <em>*</em></span>
              <select name="yas" id="yas" required>
                <option value="">{t('booking.select')}</option>
                <option value={t('booking.over18')}>{t('booking.over18')}</option>
                <option value={t('booking.under18val')}>
                  {t('booking.under18')}
                </option>
              </select>
              <span class="hint">
                {t('footer.ageNote')}
                <a href={L('/yas-ve-onam-politikasi')}>{t('footer.ageDetails')}</a>
              </span>
            </label>

            <label class="field">
              <span class="label">{t('booking.extraLabel')}</span>
              <textarea name="not" rows="2" placeholder={t('booking.ph.note')}></textarea>
            </label>
          </fieldset>

          <div class="block preview-block">
            <p class="label">{t('booking.preview')}</p>
            <pre class="msg-preview" id="msg-preview" aria-live="polite"></pre>
          </div>

          <button type="submit" class="btn btn-primary send-btn">
            {t('booking.submit')}
          </button>
          <p class="note send-note">
            {t('booking.sendNote')}
          </p>

          <noscript>
            <p class="note">
              {t('booking.noscript')}
              <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">{t('booking.noscriptLink')}</a>.
            </p>
          </noscript>
        </form>

        <aside class="alt-contact">
          <h2>{t('booking.direct')}</h2>
          <p>{t('booking.directText')}</p>
          <ul>
            <li>
              <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" class="contact-link">
                <span class="label">WhatsApp</span>
                <span class="value">{site.phone}</span>
              </a>
            </li>
            <li>
              <a href={site.instagram.url} target="_blank" rel="noopener" class="contact-link">
                <span class="label">Instagram</span>
                <span class="value">{site.instagram.handle}</span>
              </a>
            </li>
            <li>
              <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="contact-link">
                <span class="label">{t('booking.phone')}</span>
                <span class="value">{site.phone}</span>
              </a>
            </li>
          </ul>
          <div class="gold-rule"></div>
          <h3>{t('booking.address')}</h3>
          <p>{site.address.full}</p>
          {site.hours.map((h) => (
            <p class="hours"><span>{hDay(h)}</span><span>{hHours(h)}</span></p>
          ))}
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ waNumber: site.whatsapp, M, lang }}>
  function initRandevu() {
    const form = document.getElementById('randevu-form');
    if (!form || form.dataset.ready) return;
    form.dataset.ready = '1';

    const preview = document.getElementById('msg-preview');
    const gun = document.getElementById('gun');

    // Geçmiş bir gün seçilememeli.
    if (gun) gun.min = new Date().toISOString().slice(0, 10);

    const val = (name) => {
      const el = form.elements[name];
      if (!el) return '';
      if (el instanceof RadioNodeList) return el.value.trim();
      return (el.value || '').trim();
    };

    function prettyDate(iso) {
      if (!iso) return '';
      // Tarayıcı yerelini beklemeden Türkçe yaz: ziyaretçinin telefonu İngilizce
      // olsa bile mesaj stüdyoya Türkçe ulaşsın.
      const d = new Date(iso + 'T00:00:00');
      if (Number.isNaN(d.getTime())) return iso;
      const gunler = ['Pazar', 'Pazartesi', 'Salı', 'Çarşamba', 'Perşembe', 'Cuma', 'Cumartesi'];
      const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
      const p = (n) => String(n).padStart(2, '0');
      if (lang === 'en') {
        return `${p(d.getDate())}/${p(d.getMonth() + 1)}/${d.getFullYear()} ${days[d.getDay()]}`;
      }
      return `${p(d.getDate())}.${p(d.getMonth() + 1)}.${d.getFullYear()} ${gunler[d.getDay()]}`;
    }

    function buildMessage() {
      const tur = val('tur');
      const lines = [M.hello, ''];

      if (tur === M.piercing) {
        const bolge = val('piercing_bolge') || M.together;
        const adet = val('adet') || '1';
        lines.push(`${M.service}: ${M.piercing} — ${bolge}`);
        lines.push(`${M.count}: ${adet}`);
        if (val('piercing_not')) lines.push(`${M.note}: ${val('piercing_not')}`);
      } else {
        lines.push(`${M.service}: ${M.tattoo}`);
        if (val('stil')) lines.push(`${M.style}: ${val('stil')}`);
        if (val('tasarim')) lines.push(`${M.design}: ${val('tasarim')}`);
        if (val('dovme_bolge')) lines.push(`${M.area}: ${val('dovme_bolge')}`);
        if (val('boyut')) lines.push(`${M.size}: ${val('boyut')}`);
        if (val('ilk')) lines.push(`${M.firstTattoo}: ${val('ilk')}`);
      }

      lines.push('');
      lines.push(`${M.day}: ${prettyDate(val('gun')) || M.unspecified}`);
      lines.push(`${M.time}: ${val('saat') || M.anyTime}`);
      lines.push('');
      lines.push(`${M.name}: ${val('ad') || '—'}`);
      if (val('yas')) lines.push(`${M.age}: ${val('yas')}`);
      if (val('not')) lines.push(`${M.extra}: ${val('not')}`);
      lines.push('');
      lines.push(M.from);

      return lines.join('\n');
    }

    function refresh() {
      const tur = val('tur');
      form.querySelectorAll('[data-group]').forEach((el) => {
        el.hidden = el.dataset.group !== tur;
      });
      if (preview) preview.textContent = buildMessage();
    }

    form.addEventListener('input', refresh);
    form.addEventListener('change', refresh);
    refresh();

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      // Zorunlu alanları tarayıcının kendi uyarısıyla kontrol et.
      const ad = form.elements['ad'];
      const yas = form.elements['yas'];
      for (const el of [ad, yas]) {
        if (el && !el.value.trim()) {
          el.reportValidity?.();
          el.focus();
          return;
        }
      }

      const url = `https://wa.me/${waNumber}?text=${encodeURIComponent(buildMessage())}`;
      const win = window.open(url, '_blank', 'noopener');
      // Açılır pencere engellendiyse aynı sekmede devam et.
      if (!win) window.location.href = url;
    });
  }

  initRandevu();
  document.addEventListener('astro:page-load', initRandevu);
</script>

<style>
  .narrow {
    max-width: 780px;
  }

  .lead {
    max-width: 60ch;
  }

  .steps {
    list-style: none;
    margin: 1.8rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
  }

  .steps li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.88rem;
    color: var(--color-ivory-dim);
  }

  .steps span {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1px solid var(--color-gold);
    color: var(--color-gold);
    font-size: 0.78rem;
    flex-shrink: 0;
  }

  .booking-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 2rem;
    align-items: start;
  }

  .request {
    padding: clamp(1.4rem, 3vw, 2.2rem);
  }

  .block {
    border: 0;
    padding: 0;
    margin: 0 0 2rem;
  }

  .block legend {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--color-ivory);
    margin-bottom: 1rem;
    padding: 0;
  }

  .field {
    display: block;
    margin-bottom: 1rem;
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .narrow-field {
    max-width: 120px;
  }

  .label {
    display: block;
    font-size: 0.82rem;
    color: var(--color-ivory-dim);
    margin-bottom: 0.4rem;
  }

  .label em {
    color: var(--color-gold);
    font-style: normal;
  }

  .hint {
    display: block;
    font-size: 0.76rem;
    color: var(--color-ivory-faint);
    margin-top: 0.4rem;
  }

  .hint a {
    color: var(--color-gold);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  input[type='text'],
  input[type='date'],
  input[type='number'],
  select,
  textarea {
    width: 100%;
    background: var(--color-ink-900);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm);
    color: var(--color-ivory);
    font: inherit;
    font-size: 0.92rem;
    padding: 0.7em 0.9em;
  }

  textarea {
    resize: vertical;
  }

  /* Yalnızca fareyle odaklanınca halkayı gizle; klavyeyle gezende görünür kalsın. */
  input:focus:not(:focus-visible),
  select:focus:not(:focus-visible),
  textarea:focus:not(:focus-visible) {
    outline: none;
    border-color: var(--color-gold);
  }

  .choice-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    align-items: center;
  }

  .choice-row.tight {
    margin-top: 0.4rem;
  }

  .choice-row.tight .label {
    margin: 0 0.4rem 0 0;
  }

  .choice {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7em 1.2em;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-size: 0.92rem;
    transition: border-color var(--dur-fast), color var(--dur-fast);
  }

  .choice.sm {
    padding: 0.45em 0.9em;
    font-size: 0.86rem;
  }

  .choice input {
    accent-color: var(--color-gold);
  }

  .choice:has(input:checked) {
    border-color: var(--color-gold);
    color: var(--color-gold);
  }

  .note {
    font-size: 0.8rem;
    color: var(--color-ivory-faint);
    margin: 0 0 0.9rem;
  }

  .hours-note {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.2rem;
    margin-top: 0.8rem;
    margin-bottom: 0;
  }

  .preview-block .label {
    margin-bottom: 0.6rem;
  }

  /* Mesajın birebir önizlemesi: ziyaretçi ne göndereceğini görsün. */
  .msg-preview {
    background: var(--color-ink-950);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm);
    padding: 1rem 1.1rem;
    font-family: var(--font-body);
    font-size: 0.84rem;
    line-height: 1.6;
    color: var(--color-ivory-dim);
    white-space: pre-wrap;
    word-break: break-word;
    margin: 0;
    max-height: 260px;
    overflow-y: auto;
  }

  .send-btn {
    width: 100%;
    justify-content: center;
    font-size: 0.98rem;
  }

  .send-note {
    margin: 0.9rem 0 0;
  }

  .alt-contact {
    background: var(--color-ink-950);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    padding: 1.8rem;
  }

  .alt-contact h2 {
    font-size: 1.3rem;
  }

  .alt-contact ul {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .contact-link {
    display: flex;
    justify-content: space-between;
    padding: 0.7em 0;
    border-bottom: 1px solid var(--color-hairline);
    font-size: 0.9rem;
  }

  .contact-link .label {
    color: var(--color-ivory-faint);
    margin: 0;
  }

  .contact-link .value {
    color: var(--color-gold);
  }

  .alt-contact h3 {
    font-size: 1rem;
    margin-top: 1.5rem;
  }

  .hours {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    color: var(--color-ivory-dim);
    margin-bottom: 0.4em;
  }

  @media (max-width: 900px) {
    .booking-layout {
      grid-template-columns: 1fr;
    }

    /* iOS Safari, 16px'ten küçük yazılı bir alana dokunulduğunda sayfayı
       kendiliğinden yakınlaştırıyor; kullanıcı yanlara kaymış bir formda
       kalıyor. Masaüstü ölçüsü korunuyor, dokunmatikte 16px'e sabitleniyor. */
    input[type='text'],
    input[type='date'],
    input[type='number'],
    select,
    textarea {
      font-size: 16px;
    }
  }

  @media (max-width: 560px) {
    .field-row {
      grid-template-columns: 1fr;
    }
    .narrow-field {
      max-width: none;
    }
    /* Dar ekranda "Evet"/"Hayır" ikiye bölünüyordu; soru kendi satırına alınıyor. */
    .choice-row.tight .label {
      flex-basis: 100%;
      margin-bottom: 0.5rem;
    }
  }
</style>
