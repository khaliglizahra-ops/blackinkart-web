---
import { langFromPath, localizePath } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

const lang = langFromPath(Astro.url.pathname);
const t = useTranslations(lang);
const L = (p: string) => localizePath(p, lang);
import BaseLayout from '../../layouts/BaseLayout.astro';
import Faq from '../Faq.astro';
import { getFaq, faqSchema } from '../../data/faq';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { tattooPricing, tattooNotes, kdvNote } from '../../data/prices';
import { campaigns } from '../../data/campaigns';
const faq = await getFaq(lang, 'tattooPrices');
// Google başlığı ve açıklaması: yıl ve rakamlar her derlemede güncel veriden gelir.
const year = new Date().getFullYear();
const fmtN = (n: number) => n.toLocaleString(lang === 'en' ? 'en-GB' : 'tr-TR');
const threeMinimal = campaigns(lang).find((c) => c.key === 'minimal');
const seoTitle = lang === 'en' ? `Tattoo Prices in Ankara ${year}` : `Ankara Dövme Fiyatları ${year}`;
const seoDesc = lang === 'en'
  ? `Tattoo prices in Bahçelievler, Ankara: minimal tattoos up to 5 cm ${fmtN(tattooPricing.openingPrice)} TRY${threeMinimal ? `, three minimal tattoos ${fmtN(threeMinimal.price)} TRY` : ''}. Send a photo for an exact price on large pieces. VAT not included.`
  : `Ankara Bahçelievler'de dövme fiyatları: 5 cm'e kadar minimal dövme ${fmtN(tattooPricing.openingPrice)} TL${threeMinimal ? `, 3 minimal dövme ${fmtN(threeMinimal.price)} TL` : ''}. Büyük dövmede net fiyat için fotoğraf gönderin. KDV hariç.`;
---

<BaseLayout
  title={seoTitle}
  description={seoDesc}
  jsonLd={faqSchema(faq)}
  path={L('/dovme/fiyatlar')}
>
  <section class="section-tight">
    <div class="container narrow">
      <Breadcrumbs items={[{ label: t('nav.tattoo'), href: L('/dovme') }, { label: t('nav.prices') }]} />
      <p class="eyebrow">{t('nav.tattoo')}</p>
      <h1>{t('tprice.pageTitle')}</h1>
      <div class="gold-rule"></div>

      <div class="opening-price surface" data-reveal>
        <span class="label">{t('tprice.opening')}</span>
        <span class="value">{tattooPricing.openingPrice.toLocaleString('tr-TR')} {tattooPricing.currency}</span>
      </div>

      <ul class="notes" data-reveal>
        {tattooNotes(lang).map((n) => <li>{n}</li>)}
      </ul>

      <p class="kdv-note">{kdvNote(lang)}</p>

      <div class="cta surface" data-reveal>
        <div>
          <h2>{t('tprice.ctaTitle')}</h2>
          <p>{t('tprice.ctaText')}</p>
        </div>
        <div class="cta-actions">
          <a href={localizePath('/randevu', lang)} class="btn btn-primary">{t('cta.book')}</a>
          <a href={L('/hakkimizda-iletisim')} class="btn btn-outline">{t('cta.contact')}</a>
        </div>
      </div>
    </div>
  </section>
  <Faq items={faq} heading={t('faq.title')} id="faq-tattoo-prices" />
</BaseLayout>

<style>
  .narrow {
    max-width: 760px;
  }

  .opening-price {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 1.6rem 1.8rem;
    margin: 2rem 0 1.5rem;
  }

  .opening-price .label {
    font-size: 0.9rem;
    color: var(--color-ivory-dim);
  }

  .opening-price .value {
    font-family: var(--font-display);
    font-size: 2.2rem;
    color: var(--color-gold);
  }

  .notes {
    color: var(--color-ivory-dim);
    padding-left: 1.2em;
  }

  .notes li {
    margin-bottom: 0.6em;
  }

  .kdv-note {
    font-size: 0.8rem;
    color: var(--color-ivory-faint);
    font-style: italic;
    margin-top: -0.5rem;
  }

  .cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding: 2rem;
    margin-top: 2.5rem;
  }

  .cta h2 {
    margin-bottom: 0.3em;
  }

  .cta p {
    margin: 0;
  }

  .cta-actions {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
</style>
