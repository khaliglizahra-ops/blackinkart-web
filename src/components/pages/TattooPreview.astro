---
import { langFromPath, localizePath } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

const lang = langFromPath(Astro.url.pathname);
const t = useTranslations(lang);
const L = (tr: string, en: string) => (lang === 'en' ? en : tr);
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import templateData from '../../data/templates.json';

const templates = templateData.templates;

const regions = [
  { key: 'full', label: L('Tam Vücut', 'Full Body') },
  { key: 'onkol', label: L('Ön Kol', 'Forearm') },
  { key: 'ustkol', label: L('Üst Kol / Omuz', 'Upper Arm / Shoulder') },
  { key: 'gogus', label: L('Göğüs', 'Chest') },
  { key: 'sirt', label: L('Sırt', 'Back') },
  { key: 'bacak', label: L('Bacak / Baldır', 'Leg / Calf') },
];
---

<BaseLayout
  title={L('3D Dövme Önizleme', '3D Tattoo Preview')}
  description={L('Dövme tasarımınızı 3D vücut modeli üzerinde deneyin: bölgeyi seçin, modeli döndürün, dövmeyi yerleştirin; boyut, açı ve opaklığı ayarlayın.', 'Try your tattoo design on a 3D body model: choose a placement, rotate the model, position the design, and adjust its size, angle and opacity.')}
  path={localizePath('/dovme-onizleme', lang)}
>
  <section class="section-tight tool-hero">
    <div class="container narrow">
      <Breadcrumbs items={[{ label: L('3D Dövme Önizleme', '3D Tattoo Preview') }]} />
      <p class="eyebrow">{L('Beta Araç', 'Beta Tool')}</p>
      <h1>{t('home.preview.h')}</h1>
      <p class="lead">
        {L('Hazır tasarımlardan birini seçin ya da kendi tasarımınızı yükleyin; 3D vücut modelinde ya da kendi fotoğrafınızda deneyin.', 'Pick one of our ready-made designs or upload your own, then try it on a 3D body model or on your own photo.')}
      </p>
      <div class="mode-switch" role="tablist" aria-label={L('Deneme modu', 'Preview mode')}>
        <button type="button" class="mode-btn is-active" data-mode="3d" role="tab" aria-selected="true">{L('3D Model', '3D Model')}</button>
        <button type="button" class="mode-btn" data-mode="photo" role="tab" aria-selected="false">{L('Fotoğrafınla Dene', 'Try on Your Photo')}</button>
      </div>
    </div>
  </section>

  <!-- WebGL desteklenmiyorsa betik burayı açıp araç bölümlerini gizliyor. -->
  <section class="section-tight" id="webgl-fallback" role="alert" hidden>
    <div class="container narrow">
      <h2>{L('Bu cihazda 3D araç çalışmıyor', 'The 3D tool is not available on this device')}</h2>
      <p>
        {L(
          'Dövme deneme aracı tarayıcınızın WebGL (3D grafik) desteğine ihtiyaç duyuyor; bu tarayıcıda ya da cihazda WebGL kapalı görünüyor. Donanım hızlandırmayı açmayı, tarayıcıyı güncellemeyi ya da başka bir tarayıcı/cihaz denemeyi önerebiliriz.',
          'The tattoo try-on tool needs your browser to support WebGL (3D graphics), and WebGL looks unavailable here. Turning on hardware acceleration, updating your browser or trying another browser or device should help.'
        )}
      </p>
      <p>
        {L(
          'Tasarım fikrinizi bizimle paylaşmanız için aracı beklemenize gerek yok: randevu formundan yazın, stüdyoda birlikte konuşalım.',
          'You do not need the tool to share your idea with us: send a message through the booking form and we will talk it through at the studio.'
        )}
      </p>
      <p><a class="btn btn-primary" href={localizePath('/randevu', lang)}>{L('Randevu / Mesaj Bırak', 'Book / Send a Message')}</a></p>
    </div>
  </section>

  <section class="section-tight" id="mode-3d">
    <div class="container">
      <div class="studio">
        <!-- 3D viewport -->
        <div class="viewport-col">
          <div class="gender-switch" role="group" aria-label={L('Model seçimi', 'Model selection')}>
            <button type="button" class="gender-btn is-active" data-model="/models/human-body-female.obj">{L('Kadın', 'Female')}</button>
            <button type="button" class="gender-btn" data-model="/models/human-body-male.obj">{L('Erkek', 'Male')}</button>
          </div>
          <div class="viewport" id="viewport">
            <div class="loading" id="loading">
              <div class="spinner"></div>
              <span id="loading-label">{L('3D model yükleniyor…', 'Loading 3D model…')}</span>
            </div>
            <div class="zoom-controls">
              <button type="button" id="btn-zoom-in" aria-label={L('Yakınlaştır', 'Zoom in')}>+</button>
              <button type="button" id="btn-zoom-out" aria-label={L('Uzaklaştır', 'Zoom out')}>−</button>
              <button type="button" id="btn-zoom-fit" aria-label={L('Sığdır', 'Fit')} title={L('Sığdır', 'Fit')}>⤢</button>
            </div>
            <div class="pan-pad" aria-label={L('Görünümü kaydır', 'Pan the view')}>
              <button type="button" data-pan="up" aria-label={L('Yukarı kaydır', 'Pan up')}>▲</button>
              <div class="pan-row">
                <button type="button" data-pan="left" aria-label={L('Sola kaydır', 'Pan left')}>◀</button>
                <button type="button" data-pan="right" aria-label={L('Sağa kaydır', 'Pan right')}>▶</button>
              </div>
              <button type="button" data-pan="down" aria-label={L('Aşağı kaydır', 'Pan down')}>▼</button>
            </div>
            <p class="viewport-hint" id="viewport-hint">
              {L('Döndür: sürükle · Kaydır: ok tuşları ya da Shift+sürükle · Yakınlaş: çift tık', 'Rotate: drag · Pan: arrow buttons or Shift+drag · Zoom: double-click')}
            </p>
          </div>

          <div class="region-bar">
            {regions.map((r, i) => (
              <button type="button" class="region-btn" class:list={[{ 'is-active': i === 0 }]} data-region={r.key}>
                {r.label}
              </button>
            ))}
          </div>
        </div>

        <!-- Controls -->
        <aside class="panel">
          <div class="panel-block">
            <h2>{L('1. Tasarım seçin', '1. Choose a design')}</h2>
            <div class="template-grid" id="template-grid">
              {templates.map((t) => (
                <button type="button" class="tpl-btn" data-src={t.image} title={lang === 'en' && (t as any).labelEn ? (t as any).labelEn : t.label}>
                  <img src={t.image} alt={lang === 'en' && (t as any).labelEn ? (t as any).labelEn : t.label} loading="lazy" />
                </button>
              ))}
            </div>

            <label class="upload-drop" id="upload-drop" for="tattoo-file">
              <input type="file" id="tattoo-file" accept="image/*" hidden />
              <span id="upload-label">{L('…veya kendi tasarımınızı yükleyin', '…or upload your own design')}</span>
            </label>
            <div class="processing" id="processing" hidden>
              <div class="progress-track"><div class="progress-fill" id="progress-fill"></div></div>
              <span id="progress-label">{L('Arka plan kaldırılıyor…', 'Removing background…')}</span>
            </div>
            <p class="privacy">{L('🔒 Yüklediğiniz fotoğraf cihazınızdan çıkmaz; arka plan kaldırma tamamen tarayıcınızda yapılır.', '🔒 The photo you upload never leaves your device — the background is removed entirely in your browser.')}</p>
          </div>

          <div class="panel-block">
            <h2>{L('2. Yerleştirin', '2. Position it')}</h2>
            <p class="tiny" id="place-hint">{L('Modeli döndürüp dövmeyi koymak istediğiniz yere tıklayın.', 'Rotate the model and click where you want the tattoo.')}</p>
            <label class="ctl">
              <span>{L('Boyut', 'Size')}</span>
              <input type="range" id="ctl-scale" min="4" max="60" value="20" />
            </label>
            <label class="ctl">
              <span>{L('Açı', 'Angle')}</span>
              <input type="range" id="ctl-rotate" min="-180" max="180" value="0" />
            </label>
            <label class="ctl">
              <span>{L('Opaklık', 'Opacity')}</span>
              <input type="range" id="ctl-opacity" min="20" max="100" value="92" />
            </label>
            <div class="panel-actions">
              <button type="button" id="btn-clear" class="btn btn-outline">{L('Temizle', 'Clear')}</button>
              <button type="button" id="btn-shot" class="btn btn-outline">{L('Görseli İndir', 'Download image')}</button>
            </div>
          </div>

          <div class="panel-block cta-block">
            <p>{L('Beğendiğiniz bir yerleşim mi buldunuz?', 'Found a placement you like?')}</p>
            <a href={localizePath('/randevu', lang)} class="btn btn-primary">{t('cta.book')}</a>
          </div>
        </aside>
      </div>

      <p class="disclaimer">
        {L('Bu araç bir simülasyondur: 3D model temsilîdir, gerçek sonuç vücut hatlarınıza, cilt tonunuza, tasarımın uygulanma tekniğine ve sanatçı yorumuna göre farklılık gösterir.', 'This tool is a simulation. The 3D model is representative only — the real result will vary with your body shape, skin tone, the technique used and the artist\'s interpretation.')}
      </p>
    </div>
  </section>

  <section class="section-tight" id="mode-photo" hidden>
    <div class="container">
      <div class="studio">
        <!-- photo viewport -->
        <div class="viewport-col">
          <div class="viewport photo-viewport" id="viewport-photo">
            <img id="photo-bg" alt="" />
            <span class="mask-status" id="mask-status-p" hidden><span class="dot"></span><span id="mask-status-text-p"></span></span>
            <label class="photo-drop" id="photo-drop" for="body-photo-file">
              <input type="file" id="body-photo-file" accept="image/*" hidden />
              <span class="btn btn-primary" id="photo-drop-label">{L('Fotoğrafınızı Ekleyin', 'Add Your Photo')}</span>
              <span class="tiny">{L('Kol, bacak, sırt — dövmeyi denemek istediğiniz bölgenin net bir fotoğrafı', 'Arm, leg, back — a clear photo of the area you want to try the tattoo on')}</span>
            </label>
            <p class="viewport-hint" id="photo-hint" hidden>
              {L('Dövmeyi koymak istediğiniz noktaya tıklayın.', 'Click where you want to place the tattoo.')}
            </p>
          </div>
          <button type="button" class="btn btn-outline photo-change-btn" id="btn-photo-change" hidden>
            {L('Farklı fotoğraf seç', 'Choose a different photo')}
          </button>
        </div>

        <!-- Controls -->
        <aside class="panel">
          <div class="panel-block">
            <h2>{L('1. Tasarım seçin', '1. Choose a design')}</h2>
            <div class="template-grid" id="template-grid-p">
              {templates.map((tpl) => (
                <button type="button" class="tpl-btn" data-src={tpl.image} title={lang === 'en' && (tpl as any).labelEn ? (tpl as any).labelEn : tpl.label}>
                  <img src={tpl.image} alt={lang === 'en' && (tpl as any).labelEn ? (tpl as any).labelEn : tpl.label} loading="lazy" />
                </button>
              ))}
            </div>

            <label class="upload-drop" id="upload-drop-p" for="tattoo-file-p">
              <input type="file" id="tattoo-file-p" accept="image/*" hidden />
              <span id="upload-label-p">{L('…veya kendi tasarımınızı yükleyin', '…or upload your own design')}</span>
            </label>
            <div class="processing" id="processing-p" hidden>
              <div class="progress-track"><div class="progress-fill" id="progress-fill-p"></div></div>
              <span id="progress-label-p">{L('Arka plan kaldırılıyor…', 'Removing background…')}</span>
            </div>
            <p class="privacy">{L('🔒 Yüklediğiniz fotoğraflar (vücut ve tasarım) cihazınızdan çıkmaz; her şey tamamen tarayıcınızda, sunucuya gönderilmeden işlenir.', '🔒 Every photo you upload — of your body and of the design — stays on your device. Everything runs entirely in your browser; nothing is sent to a server.')}</p>
          </div>

          <div class="panel-block">
            <h2>{L('2. Yerleştirin', '2. Position it')}</h2>
            <p class="tiny" id="place-hint-p">{L('Önce bir fotoğraf yükleyip bir tasarım seçin.', 'First upload a photo and choose a design.')}</p>
            <label class="ctl">
              <span>{L('Boyut', 'Size')}</span>
              <input type="range" id="ctl-scale-p" min="4" max="60" value="20" />
            </label>
            <label class="ctl">
              <span>{L('Açı', 'Angle')}</span>
              <input type="range" id="ctl-rotate-p" min="-180" max="180" value="0" />
            </label>
            <label class="ctl">
              <span>{L('Sarma Şiddeti', 'Wrap Strength')}</span>
              <input type="range" id="ctl-wrap-p" min="0" max="100" value="55" />
            </label>
            <label class="ctl">
              <span>{L('Opaklık', 'Opacity')}</span>
              <input type="range" id="ctl-opacity-p" min="20" max="100" value="88" />
            </label>
            <div class="panel-actions">
              <button type="button" id="btn-clear-p" class="btn btn-outline">{L('Temizle', 'Clear')}</button>
              <button type="button" id="btn-shot-p" class="btn btn-outline">{L('Görseli İndir', 'Download image')}</button>
            </div>
          </div>

          <div class="panel-block cta-block">
            <p>{L('Beğendiğiniz bir yerleşim mi buldunuz?', 'Found a placement you like?')}</p>
            <a href={localizePath('/randevu', lang)} class="btn btn-primary">{t('cta.book')}</a>
          </div>
        </aside>
      </div>

      <p class="disclaimer">
        {L('Bu araç bir simülasyondur: sarma efekti yaklaşık bir silindire dayanır, gerçek sonuç vücut hatlarınıza, cilt tonunuza, tasarımın uygulanma tekniğine ve sanatçı yorumuna göre farklılık gösterir.', 'This tool is a simulation: the wrap effect is based on an approximate cylinder. The real result will vary with your body shape, skin tone, the technique used and the artist\'s interpretation.')}
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 780px;
  }

  .lead {
    max-width: 62ch;
  }

  .mode-switch {
    display: inline-flex;
    gap: 0.3rem;
    padding: 0.3rem;
    margin-top: 1.4rem;
    border: 1px solid var(--color-hairline);
    border-radius: 30px;
    background: var(--color-ink-950);
  }

  /* display:inline-flex hidden niteliğini ezmesin. */
  .mode-switch[hidden] {
    display: none;
  }

  .mode-btn {
    font-family: var(--font-body);
    font-size: 0.84rem;
    font-weight: 600;
    padding: 0.6em 1.5em;
    border-radius: 30px;
    border: 0;
    background: transparent;
    color: var(--color-ivory-faint);
    cursor: pointer;
    transition: background var(--dur-fast), color var(--dur-fast);
  }

  .mode-btn:hover {
    color: var(--color-ivory);
  }

  .mode-btn.is-active {
    background: var(--color-gold);
    color: #150f00;
  }

  /* Fotoğraf yükleme alanı — dövme tasarımı yüklemedeki .upload-drop ile
     aynı dil, ama vücut fotoğrafı olduğu için görsel açıdan daha büyük
     ve ilk adım olarak öne çıkıyor. */
  .photo-drop {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    text-align: center;
    padding: 2rem;
    color: var(--color-ivory-dim);
    cursor: pointer;
    transition: color var(--dur-fast), background var(--dur-fast);
  }

  /* Tarayıcının [hidden] kuralı display:flex'e yeniliyor — açıkça geçersiz kılıyoruz. */
  .photo-drop[hidden] {
    display: none;
  }

  .photo-drop:hover,
  .photo-drop.is-dragover {
    color: var(--color-gold);
    background: rgba(242, 169, 0, 0.05);
  }

  .photo-drop .tiny {
    max-width: 34ch;
    font-size: 0.78rem;
    color: var(--color-ivory-faint);
  }

  .photo-viewport {
    background: radial-gradient(ellipse at 50% 30%, #17130d 0%, #050505 70%);
  }

  /* Fotoğraf, katmanların en altında düz bir <img> — dövme katmanı (WebGL
     tuvali) üstüne "multiply" ile biniyor. İkisi ayrı katman olduğu için
     mürekkep gerçekten cildin altındaymış gibi görünüyor; tek katmanda
     saydamlıkla bindirilseydi üstte yapışkan bir etiket gibi dururdu. */
  #photo-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    z-index: 0;
    pointer-events: none;
  }

  .photo-viewport :global(canvas) {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
    width: 100% !important;
    height: 100% !important;
    cursor: crosshair;
    mix-blend-mode: multiply;
  }

  .photo-drop,
  #photo-hint {
    z-index: 2;
  }

  .mask-status {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: rgba(5, 5, 5, 0.75);
    border: 1px solid var(--color-hairline);
    font-size: 0.72rem;
    color: var(--color-ivory-dim);
    pointer-events: none;
  }

  .mask-status[hidden] {
    display: none;
  }

  .mask-status .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-gold);
    animation: mask-pulse 1s ease-in-out infinite;
  }

  .mask-status.is-done .dot {
    animation: none;
  }

  @keyframes mask-pulse {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 1; }
  }

  .photo-change-btn {
    margin-top: 0.9rem;
    width: 100%;
  }

  .studio {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 1.5rem;
    align-items: start;
  }

  .viewport-col {
    min-width: 0;
  }

  .gender-switch {
    display: inline-flex;
    gap: 0.3rem;
    padding: 0.3rem;
    margin-bottom: 0.7rem;
    border: 1px solid var(--color-hairline);
    border-radius: 30px;
    background: var(--color-ink-950);
  }

  .gender-btn {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.45em 1.3em;
    border-radius: 30px;
    border: 0;
    background: transparent;
    color: var(--color-ivory-faint);
    cursor: pointer;
    transition: background var(--dur-fast), color var(--dur-fast);
  }

  .gender-btn:hover {
    color: var(--color-ivory);
  }

  .gender-btn.is-active {
    background: var(--color-gold);
    color: #150f00;
  }

  .viewport {
    position: relative;
    height: min(72vh, 640px);
    background: radial-gradient(ellipse at 50% 30%, #17130d 0%, #050505 70%);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    overflow: hidden;
    touch-action: none;
  }

  .viewport :global(canvas) {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }

  .viewport-hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.7rem;
    text-align: center;
    font-size: 0.72rem;
    color: var(--color-ivory-faint);
    margin: 0;
    pointer-events: none;
  }

  .zoom-controls {
    position: absolute;
    right: 0.8rem;
    bottom: 2.4rem;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .pan-pad {
    position: absolute;
    left: 0.8rem;
    bottom: 5.2rem;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .pan-row {
    display: flex;
    gap: 1.5rem;
  }

  .pan-pad button {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid var(--color-hairline);
    background: rgba(0, 0, 0, 0.6);
    color: var(--color-ivory-faint);
    font-size: 0.6rem;
    line-height: 1;
    cursor: pointer;
    transition: border-color var(--dur-fast), color var(--dur-fast);
  }

  .pan-pad button:hover {
    border-color: var(--color-gold);
    color: var(--color-gold);
  }




  .zoom-controls button {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--color-hairline);
    background: rgba(0, 0, 0, 0.6);
    color: var(--color-ivory-dim);
    font-size: 1.05rem;
    line-height: 1;
    cursor: pointer;
    transition: border-color var(--dur-fast), color var(--dur-fast);
  }

  .zoom-controls button:hover {
    border-color: var(--color-gold);
    color: var(--color-gold);
  }

  .loading {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background: rgba(0, 0, 0, 0.75);
    z-index: 2;
    font-size: 0.85rem;
    color: var(--color-ivory-dim);
  }

  .loading[hidden] {
    display: none;
  }

  .spinner {
    width: 30px;
    height: 30px;
    border: 2px solid var(--color-hairline);
    border-top-color: var(--color-gold);
    border-radius: 50%;
    animation: spin 800ms linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .spinner {
      animation-duration: 2.4s;
    }
  }

  .region-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.9rem;
  }

  .region-btn {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.5em 1em;
    border-radius: 30px;
    border: 1px solid var(--color-hairline);
    background: transparent;
    color: var(--color-ivory-dim);
    cursor: pointer;
    transition: border-color var(--dur-fast), color var(--dur-fast), background var(--dur-fast);
  }

  .region-btn:hover {
    border-color: var(--color-gold-35);
    color: var(--color-ivory);
  }

