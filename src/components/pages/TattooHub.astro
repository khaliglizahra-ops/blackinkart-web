---
import { langFromPath, localizePath } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { getLocalizedCollection, cleanSlug } from '../../i18n/content';

const lang = langFromPath(Astro.url.pathname);
const t = useTranslations(lang);
const L = (p: string) => localizePath(p, lang);
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideHero from '../../components/GuideHero.astro';
import ArtBackground from '../../components/ArtBackground.astro';
import { thumb } from '../../data/images';

const guides = await getLocalizedCollection('dovme-rehberi', lang);
---

<BaseLayout
  title={t('tattoo.pageTitle')}
  description={t('tattoo.pageDesc')}
  path={L('/dovme')}
>
  <GuideHero
    eyebrow={t('nav.tattoo')}
    title={t('tattoo.hubTitle')}
    breadcrumbs={[{ label: t('nav.tattoo') }]}
    image="/images/portfolyo/top30/top-11.jpg"
  />

  <section class="section-tight hub-hero">
    <div class="container">
      <p class="lead">
        {t('tattoo.hubLead')}
      </p>
      <div class="hub-actions">
        <a href={L('/dovme/fiyatlar')} class="btn btn-primary">{t('cta.seePrices')}</a>
        <a href={L('/portfolyo')} class="btn btn-outline">{t('cta.browsePortfolio')}</a>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>{t('guide.guides')}</h2>
      <div class="guide-grid">
        {guides.map((g) => (
          <a href={`${L('/dovme')}/${cleanSlug(g.slug)}`} class="guide-card surface" data-reveal>
            <div class="thumb">
              {g.data.heroImage ? (
                <img src={thumb(g.data.heroImage)} alt="" loading="lazy" />
              ) : (
                <ArtBackground variant={g.data.heroArt ?? 'flow'} seed={g.data.heroSeed ?? g.data.order} />
              )}
              <span class="index">0{g.data.order}</span>
            </div>
            <div class="card-body">
              <h3>{g.data.title}</h3>
              <p>{g.data.description}</p>
              <span class="read-more">{t('cta.readMore')}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hub-hero .lead {
    max-width: 62ch;
    font-size: 1.05rem;
  }

  .hub-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  .guide-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .guide-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: border-color var(--dur-fast), transform var(--dur-fast) var(--ease-out);
  }

  .guide-card:hover {
    border-color: var(--color-gold-35);
    transform: translateY(-3px);
  }

  .thumb {
    position: relative;
    height: 150px;
    overflow: hidden;
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease-out);
  }

  .guide-card:hover .thumb img {
    transform: scale(1.06);
  }

  .thumb::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(0, 0, 0, 0.6));
  }

  .index {
    position: absolute;
    left: 1rem;
    bottom: 0.7rem;
    z-index: 1;
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--color-gold-bright);
  }

  .card-body {
    padding: 1.4rem 1.6rem 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex-grow: 1;
  }

  .guide-card h3 {
    margin-bottom: 0.2em;
    font-size: 1.25rem;
  }

  .guide-card p {
    font-size: 0.9rem;
    flex-grow: 1;
  }

  .read-more {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-gold);
  }
</style>
