---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideArticle from '../GuideArticle.astro';
import GuideHero from '../GuideHero.astro';
import PriceTable from '../PriceTable.astro';
import MaterialCards from '../MaterialCards.astro';
import HealingChart from '../HealingChart.astro';
import { site } from '../../data/site';
import { piercingPriceTables } from '../../data/prices';
import { thumb } from '../../data/images';
import { areaPhotos as areaPhotosFor, areaCategoryKey, areaDiagram } from '../../data/gallery';
import { localizePath, type Lang } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

/**
 * Piercing bölümünün iki tür alt sayfası aynı bileşeni paylaşıyor:
 * rehber yazıları ve bölge sayfaları. İki dilde de aynı yapı.
 */
interface Props {
  kind: 'guide' | 'area';
  entry: CollectionEntry<'piercing-rehberi'> | CollectionEntry<'piercing-bolgeleri'>;
  slug: string;
  lang: Lang;
  prev: { title: string; slug: string } | null;
  next: { title: string; slug: string } | null;
}

const { kind, entry, slug, lang, prev, next } = Astro.props;
const { Content } = await render(entry as any);
const t = useTranslations(lang);
const base = localizePath('/piercing', lang);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  dateModified: entry.data.updatedAt,
  inLanguage: lang,
  author: { '@type': 'Person', name: site.founder },
  publisher: { '@type': 'Organization', name: site.name },
};

// Fotoğraflar portfolyodaki bölge kategorisinden (yoksa bölge içeriğindeki liste).
const areaPhotoList: string[] = kind === 'area' ? areaPhotosFor((entry.data as any).translationKey, (entry.data as any).photos ?? []) : [];
const areaCategory = kind === 'area' ? areaCategoryKey((entry.data as any).translationKey) : undefined;
const areaDiagramSrc = kind === 'area' ? areaDiagram((entry.data as any).translationKey) : undefined;
// Panelden silinebilir ya da kimliği değiştirilebilir — bulunamazsa sayfa çökmemeli.
const priceTable = kind === 'area'
  ? piercingPriceTables(lang).find((tb) => tb.slug === (entry.data as any).priceSlug) ?? null
  : null;
const areaHeroImage = areaPhotoList[0];
// Izgara 4 sütun: son satır eksik kalmasın diye 4'ün katı (en çok 12) gösteriliyor.
const GALLERY_MAX = 12;
const galleryCount = Math.min(GALLERY_MAX, Math.floor((areaPhotoList.length - 1) / 4) * 4);
const gallerySansHero = galleryCount > 0 ? areaPhotoList.slice(1, 1 + galleryCount) : [];
const moreWorkHref = areaCategory ? `${localizePath('/portfolyo', lang)}?grup=piercing&kategori=${areaCategory}` : null;

// painLevel şemada Türkçe sabit; ekranda dile göre karşılığı gösteriliyor.
const PAIN_KEYS = {
  'Düşük': 'area.pain.low',
  'Orta': 'area.pain.medium',
  'Orta-Yüksek': 'area.pain.mediumHigh',
  'Yüksek': 'area.pain.high',
} as const;
const painLabel = kind === 'area'
  ? t(PAIN_KEYS[(entry.data as any).painLevel as keyof typeof PAIN_KEYS] ?? 'area.pain.medium')
  : '';
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  path={`${base}/${slug}`}
  jsonLd={jsonLd}
>
  {kind === 'guide' && (
    <GuideArticle
      hubLabel={t('piercing.hubTitle')}
      hubHref={base}
      title={entry.data.title}
      updatedAt={entry.data.updatedAt}
      heroImage={(entry.data as any).heroImage}
      heroArt={(entry.data as any).heroArt}
      heroSeed={(entry.data as any).heroSeed}
      prev={prev ? { title: prev.title, href: `${base}/${prev.slug}` } : null}
      next={next ? { title: next.title, href: `${base}/${next.slug}` } : null}
    >
      <Content />
      {slug === 'piercing-malzemeleri' || slug === 'piercing-materials' ? <MaterialCards /> : null}
      {slug === 'piercing-iyilesme-sureleri' || slug === 'piercing-healing-times' ? <HealingChart /> : null}
    </GuideArticle>
  )}

  {kind === 'area' && (
    <article class="area-page">
      <GuideHero
        eyebrow={t('area.eyebrow')}
        title={entry.data.title}
        breadcrumbs={[{ label: t('nav.piercing'), href: base }, { label: entry.data.title }]}
        image={areaHeroImage}
        art={areaHeroImage ? undefined : 'ornament'}
        seed={entry.data.order}
      />
      <div class="container narrow section-tight">
        <div class="badges" data-reveal>
          <span class="badge">{t('area.healing')}: {(entry.data as any).healingTime}</span>
          <span class="badge">{t('area.pain')}: {painLabel}</span>
        </div>

        <div class="prose" data-reveal>
          <Content />
        </div>

        {areaDiagramSrc && (
          <figure class="area-diagram" data-reveal>
            <img src={areaDiagramSrc} alt={`${entry.data.title} — ${lang === 'en' ? 'placement points' : 'nokta şeması'}`} loading="lazy" />
          </figure>
        )}

        {gallerySansHero.length > 0 && (
          <div class="area-gallery" data-reveal>
            {gallerySansHero.map((src: string) => (
              <img src={thumb(src)} data-full={src} loading="lazy" alt={`${entry.data.title} — Black Ink Art`} width="400" height="500" data-lightbox="bolge" />
            ))}
          </div>
        )}

        {moreWorkHref && (
          <p class="more-work" data-reveal>
            <a class="btn btn-outline" href={moreWorkHref}>{t('area.moreWork')}</a>
          </p>
        )}

        <h2>{t('area.prices')}</h2>
        {priceTable ? (
          <PriceTable table={priceTable} compact />
        ) : (
          <p class="price-missing">{t('area.priceMissing')}</p>
        )}
        <p class="see-all"><a href={localizePath('/piercing/fiyatlar', lang)}>{t('area.seeAllPrices')}</a></p>

        <!-- Fiyatı gördükten hemen sonra takıya bakmak için en doğru an. -->
        <a href={site.jewelryShopUrl} target="_blank" rel="noopener" class="jewelry-note" data-reveal>
          <span class="jewelry-note-brand">{t('jewelry.eyebrow')}</span>
          <span class="jewelry-note-text">
            {lang === 'en' ? <>Browse jewellery for <strong>{entry.data.title.toLowerCase()}</strong> at <strong>Piercingland</strong></> : <>{entry.data.title} için takı modellerini <strong>Piercingland</strong>'da inceleyin</>}
          </span>
          <span class="jewelry-note-go">{t('area.browse')}</span>
        </a>

        <div class="cta surface" data-reveal>
          <div>
            <h3>{lang === 'en' ? `Book a ${entry.data.title.toLowerCase()}` : `${entry.data.title} için randevu alın`}</h3>
            <p>{t('area.ctaText')}</p>
          </div>
          <div class="cta-actions">
            <a href={localizePath('/randevu', lang)} class="btn btn-primary">{t('cta.book')}</a>
            <a href={localizePath('/hakkimizda-iletisim', lang)} class="btn btn-outline">{t('cta.contact')}</a>
          </div>
        </div>
      </div>
    </article>
  )}
</BaseLayout>

<style>
  .price-missing {
    color: var(--color-ivory-dim);
    font-size: 0.9rem;
  }

  .narrow {
    max-width: 760px;
  }

  .badges {
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
    margin: 1.6rem 0 0.5rem;
  }

  .badge {
    font-size: 0.76rem;
    font-weight: 600;
    padding: 0.4em 0.9em;
    border: 1px solid var(--color-hairline);
    border-radius: 20px;
    color: var(--color-ivory-dim);
  }

  .area-gallery {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.6rem;
    margin: 2rem 0 1.2rem;
  }

  .area-diagram {
    margin: 2rem 0 0;
  }

  .area-diagram img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-hairline);
    background: var(--color-ink-950);
  }

  .more-work {
    margin: 0 0 2.5rem;
  }

  @media (max-width: 520px) {
    .area-gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .area-gallery img {
    width: 100%;
    height: 170px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-hairline);
  }

  .see-all {
    font-size: 0.9rem;
  }

  .see-all a {
    color: var(--color-gold);
  }

  /* İnce bir şerit: sayfayı bölmeden hatırlatsın, reklam gibi durmasın. */
  .jewelry-note {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    margin: 1.6rem 0 0;
    padding: 0.95rem 1.2rem;
    border: 1px solid var(--color-hairline);
    border-left: 2px solid var(--color-gold);
    border-radius: var(--radius-sm);
    background: var(--color-ink-950);
    transition: border-color var(--dur-fast), background var(--dur-fast);
  }

  .jewelry-note:hover {
    border-color: var(--color-gold-35);
    border-left-color: var(--color-gold);
    background: var(--color-ink-900);
  }

  .jewelry-note-brand {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold);
    flex-shrink: 0;
  }

  .jewelry-note-text {
    flex: 1;
    min-width: 12rem;
    font-size: 0.9rem;
    color: var(--color-ivory-dim);
  }

  .jewelry-note-text strong {
    color: var(--color-ivory);
    font-weight: 600;
  }

  .jewelry-note-go {
    font-size: 0.85rem;
    color: var(--color-gold);
    white-space: nowrap;
  }

  .cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding: 2rem;
    margin-top: 2rem;
  }

  .cta h3 {
    margin-bottom: 0.3em;
  }

  .cta p {
    margin: 0;
  }

  .cta-actions {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
</style>
