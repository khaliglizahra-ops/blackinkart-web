---
import { langFromPath, localizePath } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

const lang = langFromPath(Astro.url.pathname);
const t = useTranslations(lang);
const L = (p: string) => localizePath(p, lang);
import BaseLayout from '../../layouts/BaseLayout.astro';
import Faq from '../Faq.astro';
import { getFaq, faqSchema } from '../../data/faq';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PriceTable from '../../components/PriceTable.astro';
import { piercingPriceTables, kdvNote, multiPiercingNote } from '../../data/prices';
const faq = await getFaq(lang, 'piercingPrices');
// Google başlığı ve açıklaması: yıl ve rakamlar her derlemede güncel veriden gelir.
const year = new Date().getFullYear();
const fmtN = (n: number) => n.toLocaleString(lang === 'en' ? 'en-GB' : 'tr-TR');
const allRows = piercingPriceTables(lang).flatMap((tb) => tb.rows);
const minOf = (k: 'steel' | 'titanium') => Math.min(...allRows.map((r) => r[k]).filter((v): v is number => typeof v === 'number' && v > 0));
const seoTitle = lang === 'en' ? `Piercing Prices in Ankara ${year}` : `Ankara Piercing Fiyatları ${year}`;
const seoDesc = lang === 'en'
  ? `Piercing prices in Bahçelievler, Ankara: from ${fmtN(minOf('steel'))} TRY with surgical steel, from ${fmtN(minOf('titanium'))} TRY with titanium. Full list for ear, nose, lip, tongue and more. VAT not included.`
  : `Ankara Bahçelievler'de piercing fiyatları: cerrahi çelikle ${fmtN(minOf('steel'))} TL'den, titanyumla ${fmtN(minOf('titanium'))} TL'den. Kulak, burun, dudak, dil ve tüm bölgelerin listesi. KDV hariç.`;
---

<BaseLayout
  title={seoTitle}
  description={seoDesc}
  jsonLd={faqSchema(faq)}
  path={L('/piercing/fiyatlar')}
>
  <section class="section-tight">
    <div class="container narrow">
      <Breadcrumbs items={[{ label: t('nav.piercing'), href: L('/piercing') }, { label: t('nav.prices') }]} />
      <p class="eyebrow">Piercing</p>
      <h1>{t('pprice.h1')}</h1>
      <p class="lead">
        {t('pprice.lead')}
        <a href="/piercing/piercing-malzemeleri">Piercing Malzemeleri</a>.
      </p>
      <div class="gold-rule"></div>

      {piercingPriceTables(lang).map((table) => <PriceTable table={table} />)}

      <p class="note">{multiPiercingNote(lang)}</p>
      <p class="kdv-note">{kdvNote(lang)}</p>

      <div class="cta surface" data-reveal>
        <div>
          <h2>{t('pprice.ctaTitle')}</h2>
          <p>{t('pprice.ctaText')}</p>
        </div>
        <div class="cta-actions">
          <a href={localizePath('/randevu', lang)} class="btn btn-primary">{t('cta.book')}</a>
          <a href={L('/hakkimizda-iletisim')} class="btn btn-outline">{t('cta.contact')}</a>
        </div>
      </div>
    </div>
  </section>
  <Faq items={faq} heading={t('faq.title')} id="faq-piercing-prices" />
</BaseLayout>

<style>
  .narrow {
    max-width: 820px;
  }

  .lead {
    max-width: 60ch;
  }

  .lead a {
    color: var(--color-gold);
  }

  .note {
    font-size: 0.85rem;
    color: var(--color-ivory-dim);
  }

  .kdv-note {
    font-size: 0.8rem;
    color: var(--color-ivory-faint);
    font-style: italic;
  }

  .cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding: 2rem;
    margin-top: 1.5rem;
  }

  .cta h2 {
    margin-bottom: 0.3em;
  }

  .cta p {
    margin: 0;
  }

  .cta-actions {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
</style>
