---
import { langFromPath, localizePath } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { getLocalizedCollection, cleanSlug } from '../../i18n/content';

const lang = langFromPath(Astro.url.pathname);
const t = useTranslations(lang);
const L = (p: string) => localizePath(p, lang);
// Kategori adları panelde Türkçe; İngilizce karşılığı varsa o gösteriliyor.
const catLabel = (g: any) => (lang === 'en' && g.labelEn ? g.labelEn : g.label);
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { dovmeGalleries, piercingGalleries, topPortfolio } from '../../data/gallery';
import { thumb } from '../../data/images';
---

<BaseLayout
  title={t('portfolio.pageTitle')}
  description={t('portfolio.pageDesc')}
  path={L('/portfolyo')}
>
  <section class="section-tight">
    <div class="container">
      <Breadcrumbs items={[{ label: t('nav.portfolio') }]} />
      <p class="eyebrow">{t('nav.portfolio')}</p>
      <h1>{t('portfolio.h1')}</h1>
      <p class="lead">{t('portfolio.lead')}</p>
    </div>
  </section>

  <section class="section-tight featured">
    <div class="container">
      <h2>{t('portfolio.featured')}</h2>
      <div class="featured-grid">
        {topPortfolio.map((src, i) => (
          <div class="tile" data-reveal>
            <img src={thumb(src)} data-full={src} alt={t('home.portfolio.alt')} loading={i < 6 ? 'eager' : 'lazy'} width="500" height="500" data-lightbox="one-cikanlar" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>{t('portfolio.byStyle')}</h2>

      <div class="group-tabs" role="tablist" aria-label={t('portfolio.groupLabel')}>
        <button class="group-tab is-active" data-group="dovme" role="tab" aria-selected="true">{t('nav.tattoo')}</button>
        <button class="group-tab" data-group="piercing" role="tab" aria-selected="false">{t('nav.piercing')}</button>
      </div>

      <div class="style-group" data-group="dovme">
        <div class="filters" role="tablist" aria-label={t('portfolio.filterLabel')}>
          <button class="filter-btn is-active" data-filter="all" role="tab" aria-selected="true">{t('portfolio.all')}</button>
          {dovmeGalleries.map((g) => (
            <button class="filter-btn" data-filter={g.key} role="tab" aria-selected="false">{catLabel(g)}</button>
          ))}
        </div>

        <div class="filtered-grid">
          {dovmeGalleries.map((g) =>
            g.images.map((src) => (
              <div class="tile" data-category={g.key} data-reveal>
                <img src={thumb(src)} data-full={src} alt={`${catLabel(g)} — Black Ink Art`} loading="lazy" width="500" height="500" data-lightbox="stiller" data-caption={`${catLabel(g)} — Black Ink Art`} />
                <span class="tag">{catLabel(g)}</span>
              </div>
            ))
          )}
        </div>
      </div>

      <div class="style-group" data-group="piercing" hidden>
        <div class="filters" role="tablist" aria-label={t('portfolio.filterLabelPiercing')}>
          <button class="filter-btn is-active" data-filter="all" role="tab" aria-selected="true">{t('portfolio.all')}</button>
          {piercingGalleries.map((g) => (
            <button class="filter-btn" data-filter={g.key} role="tab" aria-selected="false">{catLabel(g)}</button>
          ))}
        </div>

        <div class="filtered-grid">
          {piercingGalleries.map((g) =>
            g.images.map((src) => (
              <div class="tile" data-category={g.key} data-reveal>
                <img src={thumb(src)} data-full={src} alt={`${catLabel(g)} — Black Ink Art`} loading="lazy" width="500" height="500" data-lightbox="bolgeler" data-caption={`${catLabel(g)} — Black Ink Art`} />
                <span class="tag">{catLabel(g)}</span>
              </div>
            ))
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight cta-band">
    <div class="container cta-inner surface" data-reveal>
      <div>
        <h3>{t('portfolio.ctaTitle')}</h3>
        <p>{t('portfolio.ctaText')}</p>
      </div>
      <div class="cta-actions">
        <a href={L('/randevu')} class="btn btn-primary">{t('cta.book')}</a>
        <a href={L('/dovme')} class="btn btn-outline">{t('tattoo.hubTitle')}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lead {
    max-width: 56ch;
  }

  h2 {
    margin-bottom: 1.5rem;
  }

  .featured-grid,
  .filtered-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.9rem;
  }

  .tile {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-hairline);
    aspect-ratio: 1 / 1;
  }

  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease-out);
  }

  .tile:hover img {
    transform: scale(1.06);
  }

  .tile .tag {
    position: absolute;
    left: 0.6em;
    bottom: 0.6em;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background: rgba(0, 0, 0, 0.65);
    color: var(--color-gold);
    padding: 0.3em 0.7em;
    border-radius: 3px;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity var(--dur-fast), transform var(--dur-fast);
  }

  .tile:hover .tag {
    opacity: 1;
    transform: translateY(0);
  }

  .group-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.6rem;
  }

  .group-tab {
    font-family: var(--font-body);
    font-size: 0.92rem;
    font-weight: 700;
    padding: 0.65em 1.7em;
    border-radius: 30px;
    border: 1px solid var(--color-hairline);
    background: transparent;
    color: var(--color-ivory-dim);
    cursor: pointer;
    transition: border-color var(--dur-fast), color var(--dur-fast), background var(--dur-fast);
  }

  .group-tab:hover {
    border-color: var(--color-gold-35);
    color: var(--color-ivory);
  }

  .group-tab.is-active {
    background: var(--color-gold);
    border-color: var(--color-gold);
    color: #150f00;
  }

  .style-group[hidden] {
    display: none;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1.8rem;
  }

  .filter-btn {
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.55em 1.2em;
    border-radius: 30px;
    border: 1px solid var(--color-hairline);
    background: transparent;
    color: var(--color-ivory-dim);
    cursor: pointer;
    transition: border-color var(--dur-fast), color var(--dur-fast), background var(--dur-fast);
  }

  .filter-btn:hover {
    border-color: var(--color-gold-35);
    color: var(--color-ivory);
  }

  .filter-btn.is-active {
    background: var(--color-gold);
    border-color: var(--color-gold);
    color: #150f00;
  }

  .filtered-grid .tile[hidden] {
    display: none;
  }

  .cta-band {
    padding-top: 0;
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding: 2.2rem;
  }

  .cta-inner h3 {
    margin-bottom: 0.3em;
  }

  .cta-inner p {
    margin: 0;
  }

  .cta-actions {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
</style>

<script>
  // Üst sekme: Dövme / Piercing arasında geçiş — ilgili .style-group'u gösterir.
  const groupTabs = document.querySelectorAll<HTMLButtonElement>('.group-tab');
  const groups = document.querySelectorAll<HTMLElement>('.style-group');

  groupTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      groupTabs.forEach((t) => {
        t.classList.toggle('is-active', t === tab);
        t.setAttribute('aria-selected', String(t === tab));
      });
      groups.forEach((group) => {
        group.hidden = group.dataset.group !== tab.dataset.group;
      });
    });
  });

  // Alt filtre: her grup kendi düğmelerini ve karolarını yönetir, böylece
  // gizli gruptaki bir filtre görünen grubu etkilemez.
  groups.forEach((group) => {
    const buttons = group.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const tiles = group.querySelectorAll<HTMLElement>('.tile');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter;
        buttons.forEach((b) => {
          b.classList.toggle('is-active', b === btn);
          b.setAttribute('aria-selected', String(b === btn));
        });
        tiles.forEach((tile) => {
          const show = filter === 'all' || tile.dataset.category === filter;
          tile.hidden = !show;
        });
      });
    });
  });
</script>
