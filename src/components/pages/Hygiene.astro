---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import { studioPhotos } from '../../data/gallery';
import { thumb } from '../../data/images';
import { langFromPath, localizePath } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

const lang = langFromPath(Astro.url.pathname);
const t = useTranslations(lang);
const L = (tr: string, en: string) => (lang === 'en' ? en : tr);

const certificates = [
  {
    title: L('Ustalık Belgesi — Dövme', 'Master Craftsman Certificate — Tattooing'),
    issuer: L('Türkiye Esnaf ve Sanatkârları Konfederasyonu', 'Confederation of Turkish Tradesmen and Craftsmen'),
    detail: L('3308 sayılı Mesleki Eğitim Kanunu kapsamında, sınav sonucunda verilen ustalık belgesi', 'Master craftsman certificate awarded by examination under Turkish Vocational Training Law No. 3308'),
    date: '2020',
    image: '/images/sertifikalar/ustalik-belgesi-2020.jpg',
  },
  {
    title: L('Kalfalık Belgesi — Dövme', 'Journeyman Certificate — Tattooing'),
    issuer: L('Türkiye Esnaf ve Sanatkârları Konfederasyonu', 'Confederation of Turkish Tradesmen and Craftsmen'),
    detail: L('Ustalık belgesinin ön şartı olan kalfalık yeterliliği', 'The journeyman qualification required before master craftsman status'),
    date: '2020',
    image: '/images/sertifikalar/kalfalik-belgesi-2020.jpg',
  },
  {
    title: L('Dövme Uygulayıcılığı Eğitimi', 'Tattoo Practitioner Training'),
    issuer: L('T.C. Millî Eğitim Bakanlığı', 'Turkish Ministry of National Education'),
    detail: L('30 saatlik teorik ve uygulamalı eğitim · "Pekiyi" derece', '30 hours of theory and practice · graded "Excellent"'),
    date: '2017',
    image: '/images/sertifikalar/dovme-uygulayiciligi-2017.jpg',
  },
  {
    title: L('Salgın Döneminde Hijyen Kuralları Eğitimi', 'Hygiene Rules During an Epidemic'),
    issuer: L('T.C. Millî Eğitim Bakanlığı · Çankaya Halk Eğitim Merkezi', 'Turkish Ministry of National Education · Çankaya Public Education Centre'),
    detail: L('8 saatlik katılım belgesi', '8-hour certificate of attendance'),
    date: '2022',
    image: '/images/sertifikalar/hijyen-salgin-2022.jpg',
  },
  {
    title: L('Güzellik ve Saç Bakım Hizmetlerinde Çalışanlar İçin Hijyen Eğitimi', 'Hygiene Training for Beauty and Hair Care Workers'),
    issuer: L('T.C. Millî Eğitim Bakanlığı · Çankaya Halk Eğitim Merkezi', 'Turkish Ministry of National Education · Çankaya Public Education Centre'),
    detail: L('8 saatlik kurs bitirme belgesi', '8-hour course completion certificate'),
    date: '2022',
    image: '/images/sertifikalar/hijyen-guzellik-2022.jpg',
  },
  {
    title: L('Gıda ve Su Sektöründe Çalışanlar İçin Hijyen Eğitimi', 'Hygiene Training for Food and Water Sector Workers'),
    issuer: L('T.C. Millî Eğitim Bakanlığı · Çankaya Halk Eğitim Merkezi', 'Turkish Ministry of National Education · Çankaya Public Education Centre'),
    detail: L('8 saatlik kurs bitirme belgesi', '8-hour course completion certificate'),
    date: '2022',
    image: '/images/sertifikalar/hijyen-gida-2022.jpg',
  },
];

const checklist = [
  L('Her uygulamada tek kullanımlık, steril paketinden müşterinin gözü önünde açılan iğne kullanılır.', 'Every procedure uses a single-use needle, opened from its sterile packaging in front of the customer.'),
  L('Tekrar kullanılabilir metal ekipman (pens, tutucu vb.) her kullanım sonrası otoklavda sterilize edilir.', 'Reusable metal instruments (forceps, clamps and so on) are autoclave-sterilised after every use.'),
  L('Çalışma yüzeyleri her müşteriden önce dezenfekte edilir ve tek kullanımlık örtüyle kaplanır.', 'Work surfaces are disinfected before every customer and covered with a single-use drape.'),
  L('Uygulama boyunca tek kullanımlık steril eldiven kullanılır.', 'Single-use sterile gloves are worn throughout the procedure.'),
  L('İğne ve kesici atıklar tıbbi atık prosedürüne uygun şekilde ayrıştırılır.', 'Needles and sharps are separated in line with clinical waste procedure.'),
  L('Boya ve solüsyonlar tek kullanımlık potalara alınır, kalan malzeme bir sonraki müşteriye kullanılmaz.', 'Inks and solutions are decanted into single-use caps; anything left over is never used on the next customer.'),
];
---

<BaseLayout
  title={t('nav.hygiene')}
  description={L("Black Ink Art'ta steril ekipman, otoklav sterilizasyonu ve MEB onaylı hijyen sertifikalarıyla güvenli dövme ve piercing uygulaması.", 'Safe tattooing and piercing at Black Ink Art with sterile equipment, autoclave sterilisation and accredited hygiene certification.')}
  path={localizePath('/hijyen-ve-guvenlik', lang)}
>
  <section class="section-tight">
    <div class="container narrow">
      <Breadcrumbs items={[{ label: t('nav.hygiene') }]} />
      <p class="eyebrow">{L('Güven', 'Trust')}</p>
      <h1>{t('nav.hygiene')}</h1>
      <p class="lead">
        {L('Dövme ve piercing, cildi delen kalıcı işlemlerdir — bu yüzden hijyen bizim için pazarlık konusu değildir. Stüdyomuzda uyguladığımız standartlar ve aldığımız eğitimler aşağıdadır.', 'Tattooing and piercing break the skin and leave permanent results — which is why hygiene is not something we negotiate on. The standards we work to and the training we have completed are set out below.')}
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container narrow">
      <h2>{L('Stüdyo Standartlarımız', 'Our Studio Standards')}</h2>
      <ul class="checklist" data-reveal>
        {checklist.map((item) => (
          <li>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M9.55 17.6 4.9 12.95l1.4-1.4 3.25 3.25 8.15-8.15 1.4 1.4Z"/></svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-tight">
    <div class="container narrow">
      <h2>{L('Sertifikalarımız', 'Our Certifications')}</h2>
      <p class="cert-note">
        {L('Belgelerin üzerine tıklayarak büyütebilirsiniz. Kimlik numarası, anne–baba adı ve doğum tarihi gibi kişisel bilgiler güvenlik gerekçesiyle kapatılmıştır; belgelerin kurum, program ve tarih bilgileri olduğu gibi görünmektedir.', 'Click a certificate to enlarge it. Personal details such as ID number, parents\' names and date of birth have been redacted for security. The issuing body, programme and date are shown as they appear.')}
      </p>
      <div class="cert-list">
        {certificates.map((c) => (
          <div class="cert-card surface" data-reveal>
            <img
              src={c.image}
              alt={`${c.title} — ${c.issuer}`}
              loading="lazy"
              width="150"
              height="110"
              data-lightbox="sertifikalar"
              data-caption={`${c.title} · ${c.issuer} · ${c.date}`}
            />
            <div>
              <span class="cert-date">{c.date}</span>
              <h3>{c.title}</h3>
              <p class="issuer">{c.issuer}</p>
              <p class="detail">{c.detail}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>{L('Stüdyomuzdan', 'Inside the Studio')}</h2>
      <div class="studio-grid">
        {studioPhotos.map((src) => (
          <div class="tile" data-reveal>
            <img src={thumb(src)} data-full={src} alt={t('home.studio.alt')} loading="lazy" width="500" height="400" data-lightbox="studyo" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container narrow cta surface" data-reveal>
      <div>
        <h3>{t('guide.ctaTitle')}</h3>
        <p>{L('Hijyen protokollerimiz veya stüdyomuz hakkında merak ettiklerinizi sorun.', 'Ask us anything about our hygiene protocols or the studio itself.')}</p>
      </div>
      <div class="cta-actions">
        <a href={localizePath('/randevu', lang)} class="btn btn-primary">{t('cta.book')}</a>
        <a href={localizePath('/hakkimizda-iletisim', lang)} class="btn btn-outline">{t('cta.contact')}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 780px;
  }

  .lead {
    max-width: 62ch;
  }

  h2 {
    margin-bottom: 1.2rem;
  }

  .checklist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .checklist li {
    display: flex;
    align-items: flex-start;
    gap: 0.8em;
    color: var(--color-ivory-dim);
  }

  .checklist svg {
    flex-shrink: 0;
    margin-top: 0.2em;
    color: var(--color-gold);
  }

  .cert-note {
    font-size: 0.85rem;
    color: var(--color-ivory-faint);
    max-width: 68ch;
    margin-bottom: 1.4rem;
  }

  .cert-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cert-card {
    display: flex;
    gap: 1.3rem;
    padding: 1.2rem 1.4rem;
    align-items: center;
  }

  /* Küçük ama okunur bir önizleme; tıklanınca tam boy açılıyor. */
  .cert-card img {
    width: 150px;
    height: 110px;
    flex-shrink: 0;
    object-fit: cover;
    object-position: top center;
    background: #fff;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm);
    transition: border-color var(--dur-fast), transform var(--dur-fast) var(--ease-out);
  }

  .cert-card img:hover {
    border-color: var(--color-gold);
    transform: translateY(-2px);
  }

  .cert-date {
    display: block;
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--color-gold);
    margin-bottom: 0.15em;
  }

  .cert-card h3 {
    margin-bottom: 0.2em;
    font-size: 1.15rem;
  }

  @media (max-width: 560px) {
    .cert-card {
      flex-direction: column;
      align-items: flex-start;
    }
    .cert-card img {
      width: 100%;
      height: 150px;
    }
  }

  .issuer {
    font-size: 0.85rem;
    color: var(--color-ivory-dim);
    margin-bottom: 0.2em;
  }

  .detail {
    font-size: 0.82rem;
    color: var(--color-ivory-faint);
    margin: 0;
  }

  .studio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.9rem;
  }

  .tile {
    overflow: hidden;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-hairline);
    aspect-ratio: 5 / 4;
  }

  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding: 2rem;
  }

  .cta h3 {
    margin-bottom: 0.3em;
  }

  .cta p {
    margin: 0;
  }

  .cta-actions {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
</style>
