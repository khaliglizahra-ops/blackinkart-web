---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import { site } from '../../data/site';
import { langFromPath, localizePath } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

const lang = langFromPath(Astro.url.pathname);
// Çalışma saatleri panelde Türkçe giriliyor; `dayEn`/`hoursEn` varsa İngilizce sayfada o kullanılıyor.
const hDay = (h: any) => (lang === 'en' && h.dayEn ? h.dayEn : h.day);
const hHours = (h: any) => (lang === 'en' && h.hoursEn ? h.hoursEn : h.hours);
const t = useTranslations(lang);
const L = (tr: string, en: string) => (lang === 'en' ? en : tr);
---

<BaseLayout
  title={L('Hakkımızda ve İletişim', 'About Us & Contact')}
  description={L("Black Ink Art Tattoo Piercing'in hikayesi, Ankara Bahçelievler adresimiz, çalışma saatlerimiz ve iletişim bilgilerimiz.", 'The story of Black Ink Art Tattoo Piercing, our address in Bahçelievler, Ankara, our opening hours and contact details.')}
  path={localizePath('/hakkimizda-iletisim', lang)}
>
  <section class="section-tight">
    <div class="container narrow">
      <Breadcrumbs items={[{ label: L('Hakkımızda / İletişim', 'About / Contact') }]} />
      <p class="eyebrow">{L('Hikayemiz', 'Our Story')}</p>
      <h1>{L('Hakkımızda', 'About Us')}</h1>
      <div class="prose" data-reveal>
        <p>
          {L("Black Ink Art, 2014 yılında piercingle başlayıp 2017'de dövmeyle genişleyen bir tutkunun eseri. 2020'de Ankara Çankaya'da Aşkabat Caddesi'nde (eski 7. Cadde) kapılarını açtığımızdan bu yana, her müşterinin hikâyesini dinleyip onu kalıcı bir sanat eserine dönüştürmeyi amaçlıyoruz.", 'Black Ink Art grew out of a passion that began with piercing in 2014 and expanded into tattooing in 2017. Since we opened our doors on Aşkabat Caddesi (formerly 7th Street) in Çankaya, Ankara in 2020, our aim has been to listen to each customer\'s story and turn it into a lasting piece of art.')}
        </p>
        <p>
          {L('Ekibimiz, en yüksek hijyen standartlarına bağlı kalarak, farklı tarzlarda özelleştirilmiş tasarımlar üretiyor. Sizin için de hayalinizdeki dövmeyi veya piercingi tasarlamaktan mutluluk duyarız — ', 'Our team produces bespoke designs across a range of styles, while holding to the highest hygiene standards. We would be glad to design the tattoo or piercing you have in mind — ')}<a href={`${localizePath('/sanatcilar', lang)}/huseyin-olmez`}>{L("kurucumuz Hüseyin Ölmez'in hikâyesinin devamını okuyun", "read the rest of founder Hüseyin Ölmez's story")}</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container contact-layout">
      <div class="info-col">
        <h2>{L('İletişim Bilgileri', 'Contact Details')}</h2>
        <ul class="info-list" data-reveal>
          <li>
            <span class="label">{t('booking.address')}</span>
            <span class="value">{site.address.full}</span>
          </li>
          <li>
            <span class="label">{t('booking.phone')}</span>
            <a class="value" href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a>
          </li>
          <li>
            <span class="label">{L('E-posta', 'Email')}</span>
            <a class="value" href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <span class="label">WhatsApp</span>
            <a class="value" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">{L('Mesaj Gönder', 'Send a message')}</a>
          </li>
          <li>
            <span class="label">Instagram</span>
            <a class="value" href={site.instagram.url} target="_blank" rel="noopener">{site.instagram.handle}</a>
          </li>
          <li>
            <span class="label">{L('Piercing Takı Mağazası', 'Piercing Jewellery Shop')}</span>
            <a class="value" href={site.jewelryShopUrl} target="_blank" rel="noopener">{L('Mağazayı Ziyaret Et ↗', 'Visit the shop ↗')}</a>
          </li>
        </ul>
        <div class="gold-rule"></div>
        <h3>{L('Çalışma Saatleri', 'Opening Hours')}</h3>
        {site.hours.map((h) => (
          <p class="hours"><span>{hDay(h)}</span><span>{hHours(h)}</span></p>
        ))}
      </div>

      <div class="map-col" data-reveal>
        <iframe
          src={site.mapsEmbedSrc}
          title={L('Black Ink Art konum haritası', 'Black Ink Art location map')}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container narrow">
      <h2>{L('Mesaj Bırakın', 'Leave a Message')}</h2>
      <form name="iletisim" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="contact-form" data-reveal>
        <input type="hidden" name="form-name" value="iletisim" />
        <p class="honeypot"><label>{L('Bu alanı boş bırakın:', 'Leave this field empty:')} <input name="bot-field" /></label></p>
        <div class="field-row">
          <label>
            {t('booking.name')}
            <input type="text" name="name" required />
          </label>
          <label>
            {L('Telefon veya E-posta', 'Phone or email')}
            <input type="text" name="contact" required />
          </label>
        </div>
        <label>
          {L('Mesajınız', 'Your message')}
          <textarea name="message" rows="5" required></textarea>
        </label>
        <button type="submit" class="btn btn-primary">{L('Gönder', 'Send')}</button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 780px;
  }

  .contact-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  h2 {
    margin-bottom: 1.2rem;
  }

  .info-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .info-list li {
    display: flex;
    flex-direction: column;
    gap: 0.15em;
    padding-bottom: 0.7em;
    border-bottom: 1px solid var(--color-hairline);
  }

  .label {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ivory-faint);
  }

  .value {
    color: var(--color-ivory);
    font-size: 0.98rem;
  }

  a.value {
    color: var(--color-gold);
  }

  h3 {
    font-size: 1rem;
  }

  .hours {
    display: flex;
    justify-content: space-between;
    max-width: 320px;
    font-size: 0.9rem;
    color: var(--color-ivory-dim);
  }

  .map-col {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-hairline);
    min-height: 360px;
  }

  .map-col iframe {
    width: 100%;
    height: 100%;
    min-height: 360px;
    border: 0;
    filter: grayscale(0.3) invert(0.92) contrast(0.9);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .honeypot {
    position: absolute;
    left: -9999px;
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 0.5em;
    font-size: 0.85rem;
    color: var(--color-ivory-dim);
  }

  input,
  textarea {
    background: var(--color-ink-950);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm);
    padding: 0.8em 1em;
    color: var(--color-ivory);
    font-family: var(--font-body);
    font-size: 0.95rem;
    transition: border-color var(--dur-fast);
  }

  input:focus,
  textarea:focus {
    border-color: var(--color-gold);
  }

  /* Yalnızca fareyle odaklanınca halkayı gizle; klavyeyle gezende görünür kalsın. */
  input:focus:not(:focus-visible),
  textarea:focus:not(:focus-visible) {
    outline: none;
  }

  .contact-form .btn {
    align-self: flex-start;
  }

  @media (max-width: 800px) {
    .contact-layout {
      grid-template-columns: 1fr;
    }
    .field-row {
      grid-template-columns: 1fr;
    }
    /* 16px altı yazıda iOS Safari alana dokunulunca sayfayı yakınlaştırıyor. */
    input,
    textarea {
      font-size: 16px;
    }
  }
</style>
