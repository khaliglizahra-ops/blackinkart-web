---
import { site } from '../data/site';
import { useTranslations } from '../i18n/ui';
import { langFromPath, localizePath } from '../i18n/config';

const lang = langFromPath(Astro.url.pathname);
const t = useTranslations(lang);
const homeHref = localizePath('/', lang);

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ label: t('nav.home'), href: homeHref }, ...items].map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    item: new URL(item.href ?? '', site.url).toString(),
  })),
};
---

<nav class="breadcrumbs" aria-label={t('breadcrumbs.label')}>
  <ol>
    <li><a href={homeHref}>{t('nav.home')}</a></li>
    {items.map((item, i) => (
      <li>
        <span aria-hidden="true">/</span>
        {item.href && i < items.length - 1 ? (
          <a href={item.href}>{item.label}</a>
        ) : (
          <span aria-current="page">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />

<style>
  .breadcrumbs {
    padding-block: 1rem 0;
  }

  /* Sabit header telefonda/tablette ~80 px; sayfanın ilk bölümünün üst boşluğu
     (2,5 rem) onu aşamıyordu, ekmek kırıntısı header'ın altına girip logoya
     yapışıyordu. Yalnızca hamburger menülü genişliklerde, bölümün başındaki
     kırıntıya boşluk ekliyoruz (görselli rehber başlığı kendi boşluğunu taşıyor). */
  @media (max-width: 1100px) {
    :global(.section-tight) > :global(.container) > .breadcrumbs,
    :global(.section-tight) .breadcrumbs:first-child {
      padding-top: 3rem;
    }
    :global(.section) > :global(.container) > .breadcrumbs {
      padding-top: 2rem;
    }
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.78rem;
    color: var(--color-ivory-faint);
  }

  li {
    display: flex;
    align-items: center;
    gap: 0.4em;
  }

  a {
    /* WCAG 2.2 AA (2.5.8): dokunma hedefi en az 24 px yüksekliğinde olsun. */
    display: inline-block;
    padding-block: 0.3rem;
    color: var(--color-ivory-faint);
    transition: color var(--dur-fast);
  }

  a:hover {
    color: var(--color-gold);
  }

  [aria-current='page'] {
    color: var(--color-ivory-dim);
  }
</style>
