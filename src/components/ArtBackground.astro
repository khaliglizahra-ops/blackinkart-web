---
// Procedurally generated gold line-art, used as an editorial hero backdrop for the
// conceptual guide pages (no stock photo fits topics like "technique" or "healing time").
// Deterministic per `seed` so the same guide always renders the same artwork.

interface Props {
  variant: 'flow' | 'radiate' | 'steps' | 'waves' | 'bodymap' | 'ornament' | 'scatter' | 'lattice';
  seed?: number;
}

const { variant, seed = 7 } = Astro.props;

// Tiny deterministic PRNG (mulberry32) so builds are reproducible.
function makeRng(s: number) {
  let a = s;
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rng = makeRng(seed * 1000 + variant.length);
const W = 1200;
const H = 700;

type Line = { d: string; opacity: number; width: number };
type Circle = { cx: number; cy: number; r: number; opacity: number; fill?: boolean };

const lines: Line[] = [];
const circles: Circle[] = [];

if (variant === 'flow') {
  for (let i = 0; i < 7; i++) {
    const y0 = (H / 8) * (i + 0.5) + (rng() - 0.5) * 60;
    const c1x = W * 0.2 + rng() * 200;
    const c1y = y0 + (rng() - 0.5) * 220;
    const c2x = W * 0.6 + rng() * 200;
    const c2y = y0 + (rng() - 0.5) * 220;
    lines.push({
      d: `M -50 ${y0} C ${c1x} ${c1y}, ${c2x} ${c2y}, ${W + 50} ${y0 + (rng() - 0.5) * 100}`,
      opacity: 0.12 + rng() * 0.22,
      width: 1 + rng() * 1.4,
    });
  }
}

if (variant === 'radiate') {
  const cx = W * 0.78;
  const cy = H * 0.32;
  for (let i = 0; i < 26; i++) {
    const angle = (Math.PI * 2 * i) / 26 + rng() * 0.1;
    const len = 260 + rng() * 420;
    const x2 = cx + Math.cos(angle) * len;
    const y2 = cy + Math.sin(angle) * len;
    lines.push({ d: `M ${cx} ${cy} L ${x2} ${y2}`, opacity: 0.08 + rng() * 0.16, width: 1 });
  }
  circles.push({ cx, cy, r: 5, opacity: 0.5, fill: true });
  circles.push({ cx, cy, r: 40, opacity: 0.25 });
  circles.push({ cx, cy, r: 80, opacity: 0.15 });
}

if (variant === 'steps') {
  const y = H * 0.55;
  lines.push({ d: `M 40 ${y} L ${W - 40} ${y}`, opacity: 0.18, width: 1 });
  const n = 6;
  for (let i = 0; i < n; i++) {
    const x = 40 + ((W - 80) / (n - 1)) * i;
    const r = 10 + (i === n - 1 ? 4 : 0);
    circles.push({ cx: x, cy: y, r, opacity: 0.5 });
    circles.push({ cx: x, cy: y, r: 2.5, opacity: 0.8, fill: true });
    // small vertical tick above alternating nodes for rhythm
    if (i % 2 === 0) {
      lines.push({ d: `M ${x} ${y - 18} L ${x} ${y - 46}`, opacity: 0.14, width: 1 });
    } else {
      lines.push({ d: `M ${x} ${y + 18} L ${x} ${y + 46}`, opacity: 0.14, width: 1 });
    }
  }
}

if (variant === 'waves') {
  for (let i = 0; i < 5; i++) {
    const baseY = H * 0.25 + i * 70 + (rng() - 0.5) * 20;
    const amp = 26 + rng() * 30;
    const cycles = 2.2 + rng() * 0.8;
    let d = `M -40 ${baseY}`;
    const steps = 24;
    for (let s = 1; s <= steps; s++) {
      const x = -40 + ((W + 80) / steps) * s;
      const y = baseY + Math.sin((s / steps) * Math.PI * 2 * cycles) * amp;
      d += ` L ${x.toFixed(1)} ${y.toFixed(1)}`;
    }
    lines.push({ d, opacity: 0.1 + rng() * 0.16, width: 1.2 });
  }
}

if (variant === 'lattice') {
  const cols = 9;
  const rows = 5;
  const cw = W / cols;
  const ch = H / rows;
  for (let r = 0; r <= rows; r++) {
    for (let c = 0; c <= cols; c++) {
      const x = c * cw;
      const y = r * ch;
      if (c < cols && r < rows) {
        lines.push({ d: `M ${x} ${y} L ${x + cw} ${y + ch}`, opacity: 0.07 + rng() * 0.05, width: 1 });
      }
      if (c > 0 && r < rows) {
        lines.push({ d: `M ${x} ${y} L ${x - cw} ${y + ch}`, opacity: 0.07 + rng() * 0.05, width: 1 });
      }
    }
  }
}

if (variant === 'scatter') {
  for (let i = 0; i < 46; i++) {
    circles.push({
      cx: rng() * W,
      cy: rng() * H,
      r: 2 + rng() * 10,
      opacity: 0.08 + rng() * 0.22,
      fill: rng() > 0.4,
    });
  }
}

if (variant === 'ornament') {
  const cx = W / 2;
  const cy = H / 2;
  for (let i = 1; i <= 6; i++) {
    circles.push({ cx, cy, r: i * 46, opacity: 0.09 + i * 0.01 });
  }
  const spokes = 12;
  for (let i = 0; i < spokes; i++) {
    const angle = (Math.PI * 2 * i) / spokes;
    const r1 = 46;
    const r2 = 46 * 6;
    lines.push({
      d: `M ${cx + Math.cos(angle) * r1} ${cy + Math.sin(angle) * r1} L ${cx + Math.cos(angle) * r2} ${cy + Math.sin(angle) * r2}`,
      opacity: 0.08,
      width: 1,
    });
  }
}

if (variant === 'bodymap') {
  // Soft radial backdrop only — the literal sensitivity diagram lives in BodyPainMap.astro.
  for (let i = 0; i < 18; i++) {
    circles.push({ cx: rng() * W, cy: rng() * H, r: 1.5 + rng() * 3, opacity: 0.15 + rng() * 0.15, fill: true });
  }
}
---

<div class:list={['art-bg', `art-bg--${variant}`]} aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice">
    {lines.map((l) => (
      <path d={l.d} stroke="var(--color-gold)" stroke-width={l.width} fill="none" opacity={l.opacity} />
    ))}
    {circles.map((c) => (
      <circle
        cx={c.cx}
        cy={c.cy}
        r={c.r}
        stroke={c.fill ? 'none' : 'var(--color-gold)'}
        fill={c.fill ? 'var(--color-gold)' : 'none'}
        opacity={c.opacity}
      />
    ))}
  </svg>
</div>

<style>
  .art-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 30% 20%, rgba(242, 169, 0, 0.08), transparent 55%),
      linear-gradient(160deg, #0d0b08, #000000 70%);
  }

  .art-bg svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>
