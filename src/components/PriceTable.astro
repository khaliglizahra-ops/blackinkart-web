---
import type { PriceTableData } from '../data/prices';

interface Props {
  table: PriceTableData;
  compact?: boolean;
}

const { table, compact = false } = Astro.props;

function fmt(v: number | null) {
  if (v === null) return '—';
  return `${v.toLocaleString('tr-TR')} TL`;
}
---

<div class="price-table-wrap" data-reveal>
  {!compact && <h3>{table.title}</h3>}
  <div class="scroll">
    <table>
      <thead>
        <tr>
          <th scope="col">Uygulama</th>
          <th scope="col">Cerrahi Çelik</th>
          <th scope="col">Taşlı &amp; Ring</th>
          <th scope="col">Titanyum</th>
        </tr>
      </thead>
      <tbody>
        {table.rows.map((row) => (
          <tr>
            <th scope="row">{row.name}</th>
            {row.note ? (
              <td class="price note" colspan="3">{row.note}</td>
            ) : (
              <>
                <td class="price">{fmt(row.steel)}</td>
                <td class="price">{fmt(row.stoneRing)}</td>
                <td class="price">{fmt(row.titanium)}</td>
              </>
            )}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<style>
  .price-table-wrap {
    margin-bottom: 2.5rem;
  }

  .price-table-wrap h3 {
    margin-bottom: 0.9rem;
  }

  .scroll {
    overflow-x: auto;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
  }

  table {
    min-width: 480px;
  }

  th[scope='row'] {
    font-family: var(--font-body);
    font-weight: 600;
    color: var(--color-ivory);
    text-transform: none;
    letter-spacing: normal;
    font-size: 0.9rem;
  }

  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }

  .note {
    color: var(--color-ivory-faint);
    font-style: italic;
    font-size: 0.85rem;
  }
</style>
