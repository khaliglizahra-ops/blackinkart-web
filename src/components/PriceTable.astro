---
import type { PriceTableData } from '../data/prices';
import { useTranslations } from '../i18n/ui';
import { langFromPath, LANG_LABELS } from '../i18n/config';

interface Props {
  table: PriceTableData;
  compact?: boolean;
}

const { table, compact = false } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const t = useTranslations(lang);
const locale = LANG_LABELS[lang].htmlLang === 'en' ? 'en-GB' : 'tr-TR';

function fmt(v: number | null) {
  if (v === null) return '—';
  return `${v.toLocaleString(locale)} ${t('price.currency')}`;
}
---

<div class="price-table-wrap" data-reveal>
  {!compact && <h2>{table.title}</h2>}
  <div class="scroll">
    <table>
      <thead>
        <tr>
          <th scope="col">{t('price.service')}</th>
          <th scope="col">{t('price.steel')}</th>
          <th scope="col">{t('price.gemmed')}</th>
          <th scope="col">{t('price.titanium')}</th>
        </tr>
      </thead>
      <tbody>
        {table.rows.map((row) => (
          <tr>
            <th scope="row">{row.name}</th>
            {row.note ? (
              <td class="price note" colspan="3">{row.note}</td>
            ) : (
              <>
                <td class="price">{fmt(row.steel)}</td>
                <td class="price">{fmt(row.stoneRing)}</td>
                <td class="price">{fmt(row.titanium)}</td>
              </>
            )}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<style>
  .price-table-wrap {
    margin-bottom: 2.5rem;
  }

  .price-table-wrap h2 {
    margin-bottom: 0.9rem;
  }

  .scroll {
    overflow-x: auto;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
  }

  table {
    min-width: 480px;
  }

  th[scope='row'] {
    font-family: var(--font-body);
    font-weight: 600;
    color: var(--color-ivory);
    text-transform: none;
    letter-spacing: normal;
    font-size: 0.9rem;
  }

  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }

  .note {
    color: var(--color-ivory-faint);
    font-style: italic;
    font-size: 0.85rem;
  }
</style>
