---
import { langFromPath } from '../i18n/config';

const lang = langFromPath(Astro.url.pathname);
const L = (tr: string, en: string) => (lang === 'en' ? en : tr);
const materials = [
  {
    name: L('Titanyum', 'Titanium'),
    tag: L('İlk delim önerisi', 'Recommended for a first piercing'),
    trait: L('Biyo-uyumlu, nikel içermez, %50 daha hafif', 'Biocompatible, nickel-free, 50% lighter'),
    icon: 'M12 2l2.4 6.6L21 11l-6.6 2.4L12 20l-2.4-6.6L3 11l6.6-2.4L12 2Z',
  },
  {
    name: L('316L Cerrahi Çelik', '316L Surgical Steel'),
    tag: L('Doğru alaşımda güvenli', 'Safe in the correct alloy'),
    trait: L('Nikel oranı ≤ %0,01 mg/cm² olmalı', 'Nickel content must be ≤ 0.01 mg/cm²'),
    icon: 'M4 12h16M4 12l4-4M4 12l4 4M20 12l-4-4M20 12l-4 4',
  },
  {
    name: L('Bioplastik (PTFE)', 'Bioplast (PTFE)'),
    tag: L('Hareketli bölgeler için', 'For areas that move'),
    trait: L('Esnek, pürüzsüz yüzey, MRI-uyumlu', 'Flexible, smooth surface, MRI-safe'),
    icon: 'M12 3c4 3 7 6.5 7 10a7 7 0 1 1-14 0c0-3.5 3-7 7-10Z',
  },
];
---

<div class="material-cards" data-reveal>
  {materials.map((m) => (
    <div class="material-card">
      <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="var(--color-gold)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <path d={m.icon} />
      </svg>
      <span class="tag">{m.tag}</span>
      <h3>{m.name}</h3>
      <p>{m.trait}</p>
    </div>
  ))}
</div>

<style>
  .material-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 2rem 0 2.5rem;
  }

  .material-card {
    padding: 1.5rem 1.3rem;
    background: var(--color-ink-950);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    text-align: left;
  }

  .material-card .tag {
    display: block;
    margin-top: 0.8em;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .material-card h3 {
    font-size: 1.15rem;
    margin: 0.3em 0 0.25em;
  }

  .material-card p {
    font-size: 0.84rem;
    margin: 0;
    color: var(--color-ivory-faint);
  }

  @media (max-width: 640px) {
    .material-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
