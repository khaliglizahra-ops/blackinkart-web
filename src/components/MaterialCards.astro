---
const materials = [
  {
    name: 'Titanyum',
    tag: 'İlk delim önerisi',
    trait: 'Biyo-uyumlu, nikel içermez, %50 daha hafif',
    icon: 'M12 2l2.4 6.6L21 11l-6.6 2.4L12 20l-2.4-6.6L3 11l6.6-2.4L12 2Z',
  },
  {
    name: '316L Cerrahi Çelik',
    tag: 'Doğru alaşımda güvenli',
    trait: 'Nikel oranı ≤ %0,01 mg/cm² olmalı',
    icon: 'M4 12h16M4 12l4-4M4 12l4 4M20 12l-4-4M20 12l-4 4',
  },
  {
    name: 'Bioplastik (PTFE)',
    tag: 'Hareketli bölgeler için',
    trait: 'Esnek, pürüzsüz yüzey, MRI-uyumlu',
    icon: 'M12 3c4 3 7 6.5 7 10a7 7 0 1 1-14 0c0-3.5 3-7 7-10Z',
  },
];
---

<div class="material-cards" data-reveal>
  {materials.map((m) => (
    <div class="material-card">
      <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="var(--color-gold)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <path d={m.icon} />
      </svg>
      <span class="tag">{m.tag}</span>
      <h3>{m.name}</h3>
      <p>{m.trait}</p>
    </div>
  ))}
</div>

<style>
  .material-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 2rem 0 2.5rem;
  }

  .material-card {
    padding: 1.5rem 1.3rem;
    background: var(--color-ink-950);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    text-align: left;
  }

  .material-card .tag {
    display: block;
    margin-top: 0.8em;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .material-card h3 {
    font-size: 1.15rem;
    margin: 0.3em 0 0.25em;
  }

  .material-card p {
    font-size: 0.84rem;
    margin: 0;
    color: var(--color-ivory-faint);
  }

  @media (max-width: 640px) {
    .material-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
