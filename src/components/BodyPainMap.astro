---
import { langFromPath } from '../i18n/config';

const lang = langFromPath(Astro.url.pathname);
const L = (tr: string, en: string) => (lang === 'en' ? en : tr);

// "Dövme Acısı" yazısındaki acı haritası — stüdyonun kendi görseli, vücudun
// önü ve arkasında bölgeye göre hassasiyeti renkli noktalarla gösteriyor.
// Not: görsel Türkçe etiketli; dil değişse de görsel aynı kalıyor.
---

<figure class="pain-map" data-reveal>
  <img
    src="/images/dovme-aci-haritasi.jpg"
    alt={L(
      'Dövme acısı haritası — vücudun ön ve arka bölgelerine göre hassasiyet seviyeleri',
      'Tattoo pain map — sensitivity levels by front and back body area'
    )}
    loading="lazy"
    width="1024"
    height="1024"
  />
</figure>

<style>
  .pain-map {
    margin: 2rem 0;
    padding: 1rem;
    background: var(--color-ink-950);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
  }

  .pain-map img {
    display: block;
    width: 100%;
    height: auto;
    max-width: 560px;
    margin-inline: auto;
    border-radius: var(--radius-sm);
  }
</style>
