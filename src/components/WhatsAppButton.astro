---
import { site } from '../data/site';
---

<a
  class="whatsapp-fab"
  href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Merhaba, randevu almak istiyorum.')}`}
  target="_blank"
  rel="noopener"
  aria-label="WhatsApp üzerinden yazın"
>
  <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true">
    <path
      fill="currentColor"
      d="M16.02 3C9.4 3 4.02 8.38 4.02 15c0 2.2.6 4.27 1.63 6.05L4 29l8.16-1.6A11.94 11.94 0 0 0 16.02 27C22.64 27 28 21.62 28 15S22.64 3 16.02 3Zm0 21.7c-1.86 0-3.6-.5-5.1-1.36l-.37-.22-4.84.95.98-4.7-.24-.38A9.62 9.62 0 0 1 6.34 15c0-5.34 4.35-9.68 9.68-9.68 5.34 0 9.68 4.34 9.68 9.68 0 5.34-4.34 9.7-9.68 9.7Zm5.3-7.26c-.29-.15-1.7-.84-1.96-.93-.26-.1-.46-.15-.65.14-.19.29-.75.93-.92 1.12-.17.19-.34.22-.63.07-.29-.14-1.22-.45-2.32-1.43-.86-.76-1.44-1.7-1.6-1.99-.17-.29-.02-.44.13-.59.13-.13.29-.34.43-.5.14-.17.19-.29.29-.48.1-.19.05-.36-.02-.5-.07-.15-.65-1.57-.89-2.15-.24-.57-.48-.5-.65-.5-.17-.01-.36-.01-.55-.01-.19 0-.5.07-.76.36-.26.29-1 .98-1 2.4 0 1.41 1.03 2.77 1.17 2.96.14.19 2.03 3.1 4.92 4.35.69.3 1.22.48 1.64.61.69.22 1.32.19 1.81.11.55-.08 1.7-.7 1.94-1.37.24-.67.24-1.24.17-1.36-.07-.12-.26-.19-.55-.34Z"
    />
  </svg>
</a>

<style>
  .whatsapp-fab {
    position: fixed;
    right: clamp(1rem, 3vw, 1.75rem);
    bottom: clamp(1rem, 3vw, 1.75rem);
    z-index: 50;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #25d366;
    color: #05170c;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45), 0 0 0 0 rgba(37, 211, 102, 0.55);
    animation: pulse 2.6s ease-out infinite;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .whatsapp-fab:hover {
    transform: scale(1.08);
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45), 0 0 0 0 rgba(37, 211, 102, 0.45);
    }
    70% {
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45), 0 0 0 14px rgba(37, 211, 102, 0);
    }
    100% {
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45), 0 0 0 0 rgba(37, 211, 102, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-fab {
      animation: none;
    }
  }
</style>
