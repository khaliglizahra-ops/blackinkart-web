---
import { site } from '../data/site';
import { campaigns } from '../data/campaigns';
import { langFromPath, localizePath, LANG_LABELS } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

const lang = langFromPath(Astro.url.pathname);
const t = useTranslations(lang);
const locale = LANG_LABELS[lang].htmlLang === 'en' ? 'en-GB' : 'tr-TR';
const items = campaigns(lang);
const fmt = (n: number) => `${n.toLocaleString(locale)} TL`;
const waHref = (title: string) =>
  `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(t('campaign.waMsg').replace('{title}', title))}`;
// İlk kampanya (dövme) büyük kart, gerisi yanında yatay satırlar.
const [lead, ...rest] = items;
---

{items.length > 0 && (
  <section class="section campaigns" id="kampanyalar">
    <div class="container">
      <h2>{t('campaign.h')}</h2>
      <p class="sub">{t('campaign.sub')}</p>

      <div class="layout">
        <article class="lead surface" data-reveal>
          {lead.images.length > 0 && (
            <div class="strip">
              {lead.images.map((src) => (
                <img src={src} alt="" loading="lazy" decoding="async" width="300" height="400" />
              ))}
            </div>
          )}
          <div class="lead-body">
            <h3>{lead.title}</h3>
            <p class="price">{fmt(lead.price)}</p>
            {lead.normalTotal && <p class="was">{t('campaign.normal')}{' '}<s>{fmt(lead.normalTotal)}</s></p>}
            <p class="text">{lead.text}</p>
            <a href={waHref(lead.title)} target="_blank" rel="noopener" class="wa">{t('campaign.wa')}</a>
          </div>
        </article>

        <div class="rest">
          {rest.map((c) => (
            <article class="row surface" data-reveal>
              {c.images[0] && <img src={c.images[0]} alt="" loading="lazy" decoding="async" width="200" height="200" />}
              <div class="row-body">
                <h3>{c.title}</h3>
                <p class="text">{c.text}</p>
                <a href={waHref(c.title)} target="_blank" rel="noopener" class="wa">{t('campaign.wa')}</a>
              </div>
              <div class="row-price">
                <p class="price">{fmt(c.price)}</p>
                {c.normalTotal && <p class="was">{t('campaign.normal')}{' '}<s>{fmt(c.normalTotal)}</s></p>}
              </div>
            </article>
          ))}
        </div>
      </div>

      <div class="foot">
        <a href={localizePath('/randevu', lang)} class="btn btn-primary">{t('campaign.book')}</a>
        <a href={localizePath('/dovme/fiyatlar', lang)} class="btn btn-outline">{t('campaign.allTattoo')}</a>
        <a href={localizePath('/piercing/fiyatlar', lang)} class="btn btn-outline">{t('campaign.allPiercing')}</a>
      </div>
    </div>
  </section>
)}

<style>
  .sub {
    max-width: 48ch;
    margin: 0.4rem 0 2rem;
  }

  .layout {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 1rem;
    align-items: stretch;
  }

  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }

  .lead {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
  }

  .strip img {
    width: 100%;
    height: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: top;
  }

  .lead-body {
    padding: clamp(1.3rem, 3vw, 2rem);
  }

  .lead h3 {
    margin-bottom: 0.2rem;
  }

  .price {
    margin: 0;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 800;
    line-height: 1.1;
    color: var(--color-gold);
  }

  .was {
    margin: 0.2rem 0 0.8rem;
    font-size: 0.85rem;
    color: var(--color-ivory-faint);
  }

  .text {
    margin: 0 0 0.9rem;
  }

  .wa {
    color: var(--color-gold);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .wa:hover,
  .wa:focus-visible {
    color: var(--color-ivory);
  }

  .rest {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 1rem;
  }

  .row {
    display: grid;
    grid-template-columns: 112px 1fr auto;
    gap: 1.1rem;
    align-items: center;
    padding: 0.9rem 1.2rem 0.9rem 0.9rem;
  }

  .row img {
    width: 112px;
    height: 112px;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  .row h3 {
    margin-bottom: 0.2rem;
    font-size: 1.1rem;
  }

  .row .text {
    margin-bottom: 0.4rem;
    font-size: 0.9rem;
  }

  .row-price {
    text-align: right;
  }

  .row .price {
    font-size: 1.5rem;
  }

  .row .was {
    margin-bottom: 0;
  }

  @media (max-width: 520px) {
    .row {
      grid-template-columns: 84px 1fr;
    }
    .row img {
      width: 84px;
      height: 84px;
    }
    .row-price {
      grid-column: 1 / -1;
      text-align: left;
      display: flex;
      align-items: baseline;
      gap: 0.8rem;
    }
    .row-price .was {
      margin: 0;
    }
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem;
    margin-top: 1.5rem;
  }

</style>
