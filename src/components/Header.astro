---
import { site } from '../data/site';
import { getNav } from '../i18n/nav';
import { useTranslations } from '../i18n/ui';
import { LANGS, LANG_LABELS, langFromPath, localizePath } from '../i18n/config';
import { alternatesFor } from '../i18n/routes';
import { dovmeGalleries, piercingGalleries } from '../data/gallery';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const lang = langFromPath(currentPath);
const t = useTranslations(lang);
const nav = getNav(lang);

// "Portfolyo" menü öğesinin altında açılan alt kategoriler — dövme stilleri
// ve piercing bölgeleri, portfolio.json'dan. Yeni bir kategori eklendiğinde
// (admin panelinden) menü otomatik güncellenir, elle dokunmaya gerek kalmaz.
const catLabel = (g: any) => (lang === 'en' && g.labelEn ? g.labelEn : g.label);
const portfolioBase = localizePath('/portfolyo', lang);
const portfolioDovme = dovmeGalleries.map((g) => ({
  label: catLabel(g),
  href: `${portfolioBase}?grup=dovme&kategori=${g.key}`,
}));
const portfolioPiercing = piercingGalleries.map((g) => ({
  label: catLabel(g),
  href: `${portfolioBase}?grup=piercing&kategori=${g.key}`,
}));

// Dil değiştirici aynı sayfanın öbür dildeki karşılığına gider — ana sayfaya
// değil. Ziyaretçi fiyat sayfasındayken dil değiştirince yine fiyat
// sayfasında kalıyor.
const alternates = await alternatesFor(currentPath);
const langLinks = LANGS.map((l) => ({
  code: l,
  ...LANG_LABELS[l],
  href: alternates[l],
  current: l === lang,
}));
---

<header class="site-header" id="site-header">
  <div class="container bar">
    <a href={localizePath('/', lang)} class="brand" aria-label={`${site.shortName} — ${t('nav.home.aria')}`}>
      <img src="/brand/logo-mark.png" alt={site.shortName} width="220" height="102" />
    </a>

    <nav class="desktop-nav" aria-label={t('nav.menu')}>
      <ul>
        {nav.map((item) =>
          item.key === 'nav.portfolio' ? (
            <li class="has-dropdown">
              <a href={item.href} class="dropdown-trigger" aria-current={currentPath === item.href ? 'page' : undefined}>
                {item.label}
                <svg class="chevron" viewBox="0 0 12 8" width="10" height="7" aria-hidden="true">
                  <path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
              <div class="dropdown-panel">
                <div class="dropdown-col">
                  <p class="dropdown-heading">{t('nav.tattoo')}</p>
                  <ul>
                    {portfolioDovme.map((c) => (
                      <li><a href={c.href}>{c.label}</a></li>
                    ))}
                  </ul>
                </div>
                <div class="dropdown-col">
                  <p class="dropdown-heading">{t('nav.piercing')}</p>
                  <ul>
                    {portfolioPiercing.map((c) => (
                      <li><a href={c.href}>{c.label}</a></li>
                    ))}
                  </ul>
                </div>
              </div>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                aria-current={currentPath === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          )
        )}
      </ul>
    </nav>

    <div class="actions">
      <div class="lang-switch" role="group" aria-label={t('lang.switch')}>
        {langLinks.map((l) => (
          <a
            href={l.href}
            class="lang-opt"
            hreflang={l.htmlLang}
            lang={l.htmlLang}
            aria-current={l.current ? 'true' : undefined}
            title={l.label}
          >
            {l.short}
          </a>
        ))}
      </div>
      <a href={localizePath('/randevu', lang)} class="btn btn-primary">{t('cta.book')}</a>
      <button
        class="menu-toggle"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t('nav.openMenu')}
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" inert>
  <nav aria-label={t('nav.mobileMenu')}>
    <ul>
      {nav.map((item, i) =>
        item.key === 'nav.portfolio' ? (
          <li style={`--i:${i}`} class="has-submenu">
            <div class="mobile-nav-row">
              <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
                {item.label}
              </a>
              <button
                class="mobile-submenu-toggle"
                type="button"
                aria-expanded="false"
                aria-controls="mobile-portfolio-submenu"
                aria-label={t('nav.portfolioSubmenuToggle')}
              >
                <svg viewBox="0 0 12 8" width="14" height="10" aria-hidden="true">
                  <path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
            </div>
            <div class="mobile-submenu" id="mobile-portfolio-submenu" hidden>
              <p class="mobile-submenu-heading">{t('nav.tattoo')}</p>
              <ul>
                {portfolioDovme.map((c) => (
                  <li><a href={c.href}>{c.label}</a></li>
                ))}
              </ul>
              <p class="mobile-submenu-heading">{t('nav.piercing')}</p>
              <ul>
                {portfolioPiercing.map((c) => (
                  <li><a href={c.href}>{c.label}</a></li>
                ))}
              </ul>
            </div>
          </li>
        ) : (
          <li style={`--i:${i}`}>
            <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        )
      )}
    </ul>
    <div class="mobile-lang" role="group" aria-label={t('lang.switch')}>
      {langLinks.map((l) => (
        <a
          href={l.href}
          class="mobile-lang-opt"
          hreflang={l.htmlLang}
          lang={l.htmlLang}
          aria-current={l.current ? 'true' : undefined}
        >
          {l.label}
        </a>
      ))}
    </div>
    <a href={localizePath('/randevu', lang)} class="btn btn-primary mobile-cta">{t('cta.book')}</a>
    <a href={`https://wa.me/${site.whatsapp}`} class="mobile-whatsapp" target="_blank" rel="noopener">
      {t('cta.whatsapp')}
    </a>
  </nav>
</div>
<button class="mobile-menu-scrim" id="mobile-menu-scrim" tabindex="-1" aria-hidden="true"></button>

<style>
  .site-header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 60;
    padding-block: 1.1rem;
    transition: background var(--dur-mid) var(--ease-out), padding var(--dur-mid) var(--ease-out), border-color var(--dur-mid);
    border-bottom: 1px solid transparent;
  }

  /* Tam opak siyah: yarı saydamken menü, altından geçen açık renkli
     fotoğrafların üzerinde okunmaz hâle geliyordu. */
  .site-header.is-scrolled {
    background: #000;
    padding-block: 0.7rem;
    border-color: var(--color-hairline);
    box-shadow: 0 1px 24px rgba(0, 0, 0, 0.6);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand img {
    height: 44px;
    width: auto;
    display: block;
  }

  .desktop-nav ul {
    display: flex;
    gap: clamp(1.1rem, 1.8vw, 2.1rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .desktop-nav a {
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-ivory-dim);
    position: relative;
    padding-bottom: 4px;
    transition: color var(--dur-fast);
  }

  .desktop-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 0;
    height: 1px;
    background: var(--color-gold);
    transition: right var(--dur-mid) var(--ease-out);
  }

  .desktop-nav a:hover {
    color: var(--color-ivory);
  }

  .desktop-nav a:hover::after,
  .desktop-nav a[aria-current='page']::after {
    right: 0;
  }

  .desktop-nav a[aria-current='page'] {
    color: var(--color-gold);
  }

  /* Portfolyo öğesinin altında açılan, dövme stillerine ve piercing
     bölgelerine giden alt menü. Fare üzerine gelince (ya da klavyeyle
     odaklanınca) açılır; tıklamak yine normal şekilde /portfolyo'ya götürür. */
  .has-dropdown {
    position: relative;
  }

  .dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
  }

  .chevron {
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .has-dropdown:hover .chevron,
  .has-dropdown:focus-within .chevron {
    transform: rotate(180deg);
  }

  .dropdown-panel {
    position: absolute;
    top: calc(100% + 16px);
    left: -1rem;
    display: flex;
    gap: 2rem;
    padding: 1.3rem 1.5rem;
    background: var(--color-ink-950);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.55);
    opacity: 0;
    pointer-events: none;
    transform: translateY(6px);
    transition: opacity var(--dur-fast), transform var(--dur-fast);
  }

  .has-dropdown:hover .dropdown-panel,
  .has-dropdown:focus-within .dropdown-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .dropdown-col {
    min-width: 128px;
  }

  .dropdown-heading {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin: 0 0 0.65em;
  }

  .dropdown-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5em;
  }

  .dropdown-col a {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-ivory-dim);
    white-space: nowrap;
  }

  .dropdown-col a:hover {
    color: var(--color-gold);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /* İki harfli, ayraçlı bir çift — açılır menü değil. Yalnızca iki dil var,
     tek dokunuşla geçmek menü açtırmaktan hızlı. */
  .lang-switch {
    display: flex;
    align-items: center;
    gap: 0.1rem;
  }

  /* Menü bağlantılarıyla aynı ton. `ivory-faint` iken seçili olmayan dil,
     sayfa tepesindeki açık renkli hero fotoğrafının üzerinde kayboluyordu —
     Türkçe sayfaya gelen yabancı "EN"i göremiyordu. */
  .lang-opt {
    padding: 0.35em 0.5em;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-ivory-dim);
    border-radius: 3px;
    transition: color var(--dur-fast), background var(--dur-fast);
  }

  .lang-opt + .lang-opt {
    border-left: 1px solid var(--color-hairline);
  }

  .lang-opt:hover {
    color: var(--color-ivory);
  }

  .lang-opt[aria-current='true'] {
    color: var(--color-gold);
  }

  .mobile-lang {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
  }

  .mobile-menu a.mobile-lang-opt {
    flex: 1;
    padding: 0.7em 0.5em;
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-ivory-dim);
    border: 1px solid var(--color-hairline);
    border-bottom: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm);
  }

  .mobile-menu a.mobile-lang-opt[aria-current='true'] {
    color: var(--color-gold);
    border-color: var(--color-gold-35);
  }

  .actions .btn-primary {
    padding: 0.72em 1.4em;
    font-size: 0.82rem;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: transparent;
    border: 1px solid var(--color-hairline);
    border-radius: 3px;
    cursor: pointer;
  }

  .menu-toggle span {
    display: block;
    width: 18px;
    height: 1px;
    background: var(--color-ivory);
    margin-inline: auto;
    transition: transform var(--dur-fast) var(--ease-out), opacity var(--dur-fast);
  }

  .menu-toggle[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }
  .menu-toggle[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(84vw, 380px);
    background: var(--color-ink-950);
    border-left: 1px solid var(--color-hairline);
    z-index: 80;
    padding: 6.5rem 2rem 2rem;
    transform: translateX(100%);
    transition: transform var(--dur-mid) var(--ease-in-out);
  }

  .mobile-menu.is-open {
    transform: translateX(0);
  }

  .mobile-menu ul {
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
  }

  .mobile-menu li {
    opacity: 0;
    transform: translateX(16px);
  }

  .mobile-menu.is-open li {
    animation: slide-in var(--dur-mid) var(--ease-out) forwards;
    animation-delay: calc(var(--i) * 55ms + 120ms);
  }

  @keyframes slide-in {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .mobile-menu a {
    display: block;
    padding: 0.85em 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--color-ivory);
    border-bottom: 1px solid var(--color-hairline);
  }

  .mobile-menu a[aria-current='page'] {
    color: var(--color-gold);
  }

  /* Portfolyo satırının yanındaki açılır ok — dokunmatik ekranda hover
     olmadığı için ayrı bir düğme, tıklanınca alt kategorileri katlayıp açar. */
  .mobile-nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--color-hairline);
  }

  .mobile-nav-row a {
    flex: 1;
    border-bottom: none;
  }

  .mobile-submenu-toggle {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    background: transparent;
    border: 1px solid var(--color-hairline);
    border-radius: 50%;
    color: var(--color-ivory-dim);
    cursor: pointer;
    transition: transform var(--dur-fast) var(--ease-out), color var(--dur-fast);
  }

  .mobile-submenu-toggle[aria-expanded='true'] {
    transform: rotate(180deg);
    color: var(--color-gold);
  }

  .mobile-submenu {
    padding: 0 0 1rem 1rem;
    border-bottom: 1px solid var(--color-hairline);
  }

  .mobile-submenu[hidden] {
    display: none;
  }

  .mobile-submenu-heading {
    margin: 0.9em 0 0.5em;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .mobile-submenu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-submenu a {
    display: block;
    padding: 0.5em 0;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-ivory-dim);
    border-bottom: none;
  }

  /* Seçici bilerek `.mobile-menu a.mobile-cta`: yukarıdaki `.mobile-menu a` kuralı
     (özgüllük 0-1-1) tek başına `.mobile-cta`yı (0-1-0) yeniyor ve .btn-primary'nin
     koyu metin rengini eziyordu — altın zemin üzerinde krem yazı 1.72:1 kalıyordu. */
  .mobile-menu a.mobile-cta {
    width: 100%;
    margin-bottom: 1rem;
    color: #150f00;
  }

  .mobile-whatsapp {
    display: block;
    text-align: center;
    color: var(--color-ivory-dim);
    font-size: 0.85rem;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .mobile-menu-scrim {
    position: fixed;
    inset: 0;
    z-index: 70;
    background: rgba(0, 0, 0, 0.6);
    border: 0;
    padding: 0;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-mid);
  }

  .mobile-menu-scrim.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  @media (max-width: 860px) {
    .desktop-nav {
      display: none;
    }
    .actions .btn-primary {
      display: none;
    }
    .menu-toggle {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu,
    .mobile-menu li,
    .site-header {
      transition: none;
      animation: none !important;
    }
  }
</style>

<script>
  /**
   * Header, her sayfada bulunan bir bileşen; bu modül belge başına BİR KEZ çalışır.
   * ClientRouter ile istemci tarafı gezinmede gövde baştan yazılıyor ve buradaki
   * eleman referansları ölü düğümlere işaret ediyordu. Sonuç: ilk tıklamadan
   * sonra menü düğmesi hiç açılmıyor, header da kaydırınca siyaha dönmüyordu.
   * Bu yüzden global dinleyiciler bir kez bağlanıyor, elemanlar her sayfa
   * yüklemesinde yeniden bulunuyor.
   */
  function els() {
    return {
      header: document.getElementById('site-header'),
      toggle: document.getElementById('menu-toggle'),
      menu: document.getElementById('mobile-menu'),
      scrim: document.getElementById('mobile-menu-scrim'),
    };
  }

  function closeMenu() {
    const { toggle, menu, scrim } = els();
    toggle?.setAttribute('aria-expanded', 'false');
    menu?.classList.remove('is-open');
    scrim?.classList.remove('is-open');
    // inert: hem odağı hem ekran okuyucuyu dışarıda tutar. aria-hidden tek başına
    // odağı engellemiyordu, kapalı menüdeki bağlantılar Tab'lanabiliyordu.
    menu?.setAttribute('inert', '');
    document.body.style.overflow = '';
    // Portfolyo alt menüsü açık kalmasın — bir dahaki açılışta baştan kapalı olsun.
    document.querySelectorAll<HTMLButtonElement>('.mobile-submenu-toggle').forEach((btn) => {
      btn.setAttribute('aria-expanded', 'false');
      document.getElementById(btn.getAttribute('aria-controls') || '')?.setAttribute('hidden', '');
    });
  }

  function openMenu() {
    const { toggle, menu, scrim } = els();
    toggle?.setAttribute('aria-expanded', 'true');
    menu?.classList.add('is-open');
    scrim?.classList.add('is-open');
    menu?.removeAttribute('inert');
    document.body.style.overflow = 'hidden';
  }

  function syncHeader() {
    const { header } = els();
    if (!header) return;
    header.classList.toggle('is-scrolled', window.scrollY > 12);
  }

  function bindOnce() {
    const w = window as any;
    if (w.__hdrBound) return;
    w.__hdrBound = true;

    window.addEventListener('scroll', syncHeader, { passive: true });

    // Delegasyon: düğmeler her gezinmede yeniden oluşuyor, bu yüzden
    // dinleyiciyi düğmeye değil belgeye bağlıyoruz.
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('#menu-toggle')) {
        const { toggle } = els();
        toggle?.getAttribute('aria-expanded') === 'true' ? closeMenu() : openMenu();
      } else if (t.closest('#mobile-menu-scrim')) {
        closeMenu();
      } else if (t.closest('.mobile-submenu-toggle')) {
        const btn = t.closest('.mobile-submenu-toggle') as HTMLButtonElement;
        const submenu = document.getElementById(btn.getAttribute('aria-controls') || '');
        const wasOpen = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!wasOpen));
        submenu?.toggleAttribute('hidden', wasOpen);
      } else if (t.closest('#mobile-menu a')) {
        closeMenu();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
    });

    document.addEventListener('astro:before-preparation', closeMenu);
  }

  function init() {
    closeMenu();     // gezinme sonrası menü kapalı ve inert başlasın
    syncHeader();    // yeni sayfada doğru header durumuyla aç
  }

  bindOnce();
  init();
  document.addEventListener('astro:page-load', init);
</script>
