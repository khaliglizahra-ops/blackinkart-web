---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { studioPhotos } from '../data/gallery';
import { thumb } from '../data/images';

const certificates = [
  {
    title: 'Ustalık Belgesi — Dövme',
    issuer: 'Türkiye Esnaf ve Sanatkârları Konfederasyonu',
    detail: '3308 sayılı Mesleki Eğitim Kanunu kapsamında, sınav sonucunda verilen ustalık belgesi',
    date: '2020',
    image: '/images/sertifikalar/ustalik-belgesi-2020.jpg',
  },
  {
    title: 'Kalfalık Belgesi — Dövme',
    issuer: 'Türkiye Esnaf ve Sanatkârları Konfederasyonu',
    detail: 'Ustalık belgesinin ön şartı olan kalfalık yeterliliği',
    date: '2020',
    image: '/images/sertifikalar/kalfalik-belgesi-2020.jpg',
  },
  {
    title: 'Dövme Uygulayıcılığı Eğitimi',
    issuer: 'T.C. Millî Eğitim Bakanlığı',
    detail: '30 saatlik teorik ve uygulamalı eğitim · "Pekiyi" derece',
    date: '2017',
    image: '/images/sertifikalar/dovme-uygulayiciligi-2017.jpg',
  },
  {
    title: 'Salgın Döneminde Hijyen Kuralları Eğitimi',
    issuer: 'T.C. Millî Eğitim Bakanlığı · Çankaya Halk Eğitim Merkezi',
    detail: '8 saatlik katılım belgesi',
    date: '2022',
    image: '/images/sertifikalar/hijyen-salgin-2022.jpg',
  },
  {
    title: 'Güzellik ve Saç Bakım Hizmetlerinde Çalışanlar İçin Hijyen Eğitimi',
    issuer: 'T.C. Millî Eğitim Bakanlığı · Çankaya Halk Eğitim Merkezi',
    detail: '8 saatlik kurs bitirme belgesi',
    date: '2022',
    image: '/images/sertifikalar/hijyen-guzellik-2022.jpg',
  },
  {
    title: 'Gıda ve Su Sektöründe Çalışanlar İçin Hijyen Eğitimi',
    issuer: 'T.C. Millî Eğitim Bakanlığı · Çankaya Halk Eğitim Merkezi',
    detail: '8 saatlik kurs bitirme belgesi',
    date: '2022',
    image: '/images/sertifikalar/hijyen-gida-2022.jpg',
  },
];

const checklist = [
  'Her uygulamada tek kullanımlık, steril paketinden müşterinin gözü önünde açılan iğne kullanılır.',
  'Tekrar kullanılabilir metal ekipman (pens, tutucu vb.) her kullanım sonrası otoklavda sterilize edilir.',
  'Çalışma yüzeyleri her müşteriden önce dezenfekte edilir ve tek kullanımlık örtüyle kaplanır.',
  'Uygulama boyunca tek kullanımlık steril eldiven kullanılır.',
  'İğne ve kesici atıklar tıbbi atık prosedürüne uygun şekilde ayrıştırılır.',
  'Boya ve solüsyonlar tek kullanımlık potalara alınır, kalan malzeme bir sonraki müşteriye kullanılmaz.',
];
---

<BaseLayout
  title="Hijyen ve Güvenlik"
  description="Black Ink Art'ta steril ekipman, otoklav sterilizasyonu ve MEB onaylı hijyen sertifikalarıyla güvenli dövme ve piercing uygulaması."
  path="/hijyen-ve-guvenlik"
>
  <section class="section-tight">
    <div class="container narrow">
      <Breadcrumbs items={[{ label: 'Hijyen ve Güvenlik' }]} />
      <p class="eyebrow">Güven</p>
      <h1>Hijyen ve Güvenlik</h1>
      <p class="lead">
        Dövme ve piercing, cildi delen kalıcı işlemlerdir — bu yüzden hijyen bizim için pazarlık
        konusu değildir. Stüdyomuzda uyguladığımız standartlar ve aldığımız eğitimler aşağıdadır.
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container narrow">
      <h2>Stüdyo Standartlarımız</h2>
      <ul class="checklist" data-reveal>
        {checklist.map((item) => (
          <li>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M9.55 17.6 4.9 12.95l1.4-1.4 3.25 3.25 8.15-8.15 1.4 1.4Z"/></svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-tight">
    <div class="container narrow">
      <h2>Sertifikalarımız</h2>
      <p class="cert-note">
        Belgelerin üzerine tıklayarak büyütebilirsiniz. Kimlik numarası, anne–baba adı ve doğum
        tarihi gibi kişisel bilgiler güvenlik gerekçesiyle kapatılmıştır; belgelerin kurum, program
        ve tarih bilgileri olduğu gibi görünmektedir.
      </p>
      <div class="cert-list">
        {certificates.map((c) => (
          <div class="cert-card surface" data-reveal>
            <img
              src={c.image}
              alt={`${c.title} — ${c.issuer}`}
              loading="lazy"
              width="150"
              height="110"
              data-lightbox="sertifikalar"
              data-caption={`${c.title} · ${c.issuer} · ${c.date}`}
            />
            <div>
              <span class="cert-date">{c.date}</span>
              <h3>{c.title}</h3>
              <p class="issuer">{c.issuer}</p>
              <p class="detail">{c.detail}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Stüdyomuzdan</h2>
      <div class="studio-grid">
        {studioPhotos.map((src) => (
          <div class="tile" data-reveal>
            <img src={thumb(src)} data-full={src} alt="Black Ink Art stüdyo" loading="lazy" width="500" height="400" data-lightbox="studyo" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container narrow cta surface" data-reveal>
      <div>
        <h3>Sorularınız mı var?</h3>
        <p>Hijyen protokollerimiz veya stüdyomuz hakkında merak ettiklerinizi sorun.</p>
      </div>
      <div class="cta-actions">
        <a href="/randevu" class="btn btn-primary">Randevu Al</a>
        <a href="/hakkimizda-iletisim" class="btn btn-outline">İletişime Geç</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 780px;
  }

  .lead {
    max-width: 62ch;
  }

  h2 {
    margin-bottom: 1.2rem;
  }

  .checklist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .checklist li {
    display: flex;
    align-items: flex-start;
    gap: 0.8em;
    color: var(--color-ivory-dim);
  }

  .checklist svg {
    flex-shrink: 0;
    margin-top: 0.2em;
    color: var(--color-gold);
  }

  .cert-note {
    font-size: 0.85rem;
    color: var(--color-ivory-faint);
    max-width: 68ch;
    margin-bottom: 1.4rem;
  }

  .cert-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cert-card {
    display: flex;
    gap: 1.3rem;
    padding: 1.2rem 1.4rem;
    align-items: center;
  }

  /* Küçük ama okunur bir önizleme; tıklanınca tam boy açılıyor. */
  .cert-card img {
    width: 150px;
    height: 110px;
    flex-shrink: 0;
    object-fit: cover;
    object-position: top center;
    background: #fff;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm);
    transition: border-color var(--dur-fast), transform var(--dur-fast) var(--ease-out);
  }

  .cert-card img:hover {
    border-color: var(--color-gold);
    transform: translateY(-2px);
  }

  .cert-date {
    display: block;
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--color-gold);
    margin-bottom: 0.15em;
  }

  .cert-card h3 {
    margin-bottom: 0.2em;
    font-size: 1.15rem;
  }

  @media (max-width: 560px) {
    .cert-card {
      flex-direction: column;
      align-items: flex-start;
    }
    .cert-card img {
      width: 100%;
      height: 150px;
    }
  }

  .issuer {
    font-size: 0.85rem;
    color: var(--color-ivory-dim);
    margin-bottom: 0.2em;
  }

  .detail {
    font-size: 0.82rem;
    color: var(--color-ivory-faint);
    margin: 0;
  }

  .studio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.9rem;
  }

  .tile {
    overflow: hidden;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-hairline);
    aspect-ratio: 5 / 4;
  }

  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding: 2rem;
  }

  .cta h3 {
    margin-bottom: 0.3em;
  }

  .cta p {
    margin: 0;
  }

  .cta-actions {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
</style>
