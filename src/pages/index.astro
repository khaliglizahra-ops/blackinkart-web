---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { site } from '../data/site';
import { topPortfolio, studioPhotos } from '../data/gallery';
import { tattooPricing } from '../data/prices';
import { getCollection } from 'astro:content';

const artists = await getCollection('sanatcilar');
const artist = artists[0];   // panelden silinebilir; aşağıda koşullu render ediliyor
const teaserImages = topPortfolio.slice(0, 8);
const studioTeaser = studioPhotos.slice(0, 3);
---

<BaseLayout title="Ana Sayfa" description={site.description} path="/">
  <Hero />

  <section class="section pillars" id="hero-next">
    <div class="container pillar-grid">
      <div class="pillar" data-reveal>
        <h3>Steril Standartlar</h3>
        <p>Tek kullanımlık iğne, otoklavda sterilize edilmiş ekipman ve MEB onaylı hijyen eğitimleri.</p>
        <a href="/hijyen-ve-guvenlik" class="btn-ghost">Detaylı Bilgi →</a>
      </div>
      <div class="pillar" data-reveal>
        <h3>Deneyimli Sanatçılık</h3>
        <p>2014'ten bu yana piercing, 2017'den bu yana dövme sanatında uzmanlaşmış bir ekip.</p>
        <a href="/sanatcilar" class="btn-ghost">Sanatçıları Gör →</a>
      </div>
      <div class="pillar" data-reveal>
        <h3>Şeffaf Fiyatlandırma</h3>
        <p>Malzeme ve uygulamaya göre net fiyat listesi; sürpriz ücret yok.</p>
        <a href="/dovme/fiyatlar" class="btn-ghost">Fiyatları Gör →</a>
      </div>
    </div>
  </section>

  <section class="section services">
    <div class="container">
      <p class="eyebrow">Hizmetlerimiz</p>
      <h2>Dövme &amp; Piercing</h2>
      <div class="service-grid">
        <a href="/dovme" class="service-card" data-reveal>
          <img src={teaserImages[0] ?? '/brand/og-default.jpg'} alt="Dövme" loading="lazy" />
          <div class="service-overlay">
            <h3>Dövme</h3>
            <p>Stiller, teknikler, bakım ve {tattooPricing.openingPrice.toLocaleString('tr-TR')} {tattooPricing.currency}'den başlayan fiyatlarla kalıcı sanat.</p>
            <span class="btn btn-outline">Dövme Rehberi</span>
          </div>
        </a>
        <a href="/piercing" class="service-card" data-reveal>
          <img src="/images/piercing/kulak/kulak-01.jpg" alt="Piercing" loading="lazy" />
          <div class="service-overlay">
            <h3>Piercing</h3>
            <p>Kulaktan dile, göbekten dermale — titanyum ve bioplastik malzeme seçenekleriyle.</p>
            <span class="btn btn-outline">Piercing Rehberi</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="section preview-tool">
    <div class="container preview-inner surface" data-reveal>
      <div class="preview-copy">
        <p class="eyebrow">Yeni · Beta</p>
        <h2>Dövmenizi 3D Olarak Deneyin</h2>
        <p>
          Hazır tasarımlardan birini seçin ya da kendi tasarımınızı yükleyin; 3D vücut modelini
          döndürüp kol, omuz, sırt ya da bacak üzerine yerleştirin, boyutunu ve açısını ayarlayın.
        </p>
        <a href="/dovme-onizleme" class="btn btn-primary">3D Aracı Dene</a>
      </div>
      <div class="preview-visual" aria-hidden="true">
        <img src="/images/tattoo-templates/mandala.png" alt="" loading="lazy" class="preview-thumb" />
      </div>
    </div>
  </section>

  <section class="section portfolio-teaser">
    <div class="container">
      <div class="teaser-head">
        <div>
          <p class="eyebrow">Portfolyo</p>
          <h2>Son Çalışmalarımızdan</h2>
        </div>
        <a href="/portfolyo" class="btn-ghost">Tüm Portfolyoyu Gör →</a>
      </div>
      <div class="teaser-grid">
        {teaserImages.map((src, i) => (
          <div class="tile" data-reveal>
            <img src={src} alt="Black Ink Art dövme çalışması" loading={i < 4 ? 'eager' : 'lazy'} width="400" height="400" data-lightbox="portfolyo" />
          </div>
        ))}
      </div>
    </div>
  </section>

  {artist && (
    <section class="section artist-teaser">
      <div class="container artist-inner">
        <div class="artist-photo" data-reveal>
          <img src={artist.data.photo} alt={artist.data.name} width="440" height="550" />
        </div>
        <div class="artist-copy">
          <p class="eyebrow">Kurucu</p>
          <h2>{artist.data.name}</h2>
          <p>{artist.data.description}</p>
          <a href={`/sanatcilar/${artist.slug}`} class="btn btn-outline">Hikayesini Oku</a>
        </div>
      </div>
    </section>
  )}

  <section class="section studio-teaser">
    <div class="container">
      <p class="eyebrow">Stüdyo</p>
      <h2>Hijyen ve Güvenlik Önceliğimiz</h2>
      <p class="lead">
        Her uygulama, tek kullanımlık ve steril ekipmanla, kayıt altına alınan sterilizasyon
        protokollerine uygun şekilde yapılır.
      </p>
      <div class="studio-grid">
        {studioTeaser.map((src) => (
          <div class="tile" data-reveal>
            <img src={src} alt="Black Ink Art stüdyo" loading="lazy" width="500" height="400" data-lightbox="studyo" />
          </div>
        ))}
      </div>
      <a href="/hijyen-ve-guvenlik" class="btn btn-primary">Hijyen Standartlarımız</a>
    </div>
  </section>

  <section class="section jewelry-teaser">
    <div class="container jewelry-inner surface" data-reveal>
      <div class="jewelry-visual">
        <img
          src="/brand/piercingland-logo.png"
          alt="Piercingland — piercing takı markamız"
          loading="lazy"
          width="900"
          height="709"
        />
      </div>
      <div class="jewelry-copy">
        <p class="eyebrow">Kendi Markamız</p>
        <h2>Piercingland</h2>
        <p>
          Stüdyomuzda taktığımız piercing takıları kendi markamız Piercingland'a ait.
          Cerrahi çelik, titanyum ve altın seçenekleriyle helixten septuma, dilden göbeğe
          kadar geniş bir koleksiyon üretiyoruz.
        </p>
        <p>
          Takınızı uygulamadan önce seçmek ya da mevcut piercinginiz için yeni bir model
          bakmak isterseniz koleksiyonun tamamı mağazamızda.
        </p>
        <a href={site.jewelryShopUrl} target="_blank" rel="noopener" class="btn btn-primary">
          Takıları İncele ↗
        </a>
      </div>
    </div>
  </section>

  <section class="section final-cta">
    <div class="container cta-box surface" data-reveal>
      <div>
        <h2>Randevunuzu Bugün Alın</h2>
        <p>Ankara Bahçelievler 7. Cadde'deki stüdyomuzda hayalinizdeki tasarımı konuşalım.</p>
      </div>
      <div class="cta-actions">
        <a href="/randevu" class="btn btn-primary">Randevu Al</a>
        <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" class="btn btn-outline">WhatsApp'tan Yaz</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .pillar h3 {
    margin: 0 0 0.5em;
  }

  /* Numaraların yerine ince bir altın çizgi — sıralama hissi kalsın,
     rakamlar görünmesin. */
  .pillar::before {
    content: '';
    display: block;
    width: 42px;
    height: 2px;
    background: var(--color-gold);
    margin-bottom: 1.1rem;
  }

  h2 {
    margin-bottom: 0.6em;
  }

  .services h2,
  .portfolio-teaser h2 {
    max-width: 20ch;
  }

  .preview-inner {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    align-items: center;
    overflow: hidden;
  }

  .preview-copy {
    padding: clamp(2rem, 4vw, 3.2rem);
  }

  .preview-copy h2 {
    max-width: 16ch;
  }

  .preview-copy p {
    max-width: 46ch;
  }

  .preview-visual {
    align-self: stretch;
    min-height: 220px;
  }

  .preview-visual img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 2rem;
    background: radial-gradient(ellipse at 50% 50%, #1b160f, #0a0908);
    filter: invert(1) sepia(1) saturate(3) hue-rotate(5deg) brightness(0.95);
  }

  .service-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .service-card {
    position: relative;
    display: block;
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--color-hairline);
  }

  .service-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease-out);
  }

  .service-card:hover img {
    transform: scale(1.05);
  }

  .service-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2rem;
    background: linear-gradient(180deg, transparent 30%, rgba(0, 0, 0, 0.92) 100%);
  }

  .service-overlay p {
    color: var(--color-ivory-dim);
    font-size: 0.9rem;
    max-width: 32ch;
  }

  .service-overlay .btn {
    align-self: flex-start;
    margin-top: 0.5rem;
    background: rgba(0, 0, 0, 0.4);
  }

  .teaser-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.8rem;
  }

  .teaser-grid,
  .studio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 0.8rem;
  }

  .studio-grid {
    margin: 1.8rem 0 2rem;
  }

  .tile {
    overflow: hidden;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-hairline);
    aspect-ratio: 1 / 1;
  }

  .studio-grid .tile {
    aspect-ratio: 5 / 4;
  }

  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease-out);
  }

  .tile:hover img {
    transform: scale(1.06);
  }

  .artist-inner {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }

  .artist-photo img {
    width: 100%;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-hairline);
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .studio-teaser .lead {
    max-width: 60ch;
  }

  /* 3D aracı kartının aynası: görsel solda, metin sağda. Sayfayı aşağı inerken
     aynı düzenin tekrar etmemesi için yön çevrildi. */
  .jewelry-inner {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    align-items: center;
    overflow: hidden;
  }

  .jewelry-visual {
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 240px;
    /* Logonun kendi zemini saf siyah; kartın zemini #0a0a0a. Aradaki fark gözle
       seçilmiyor ama kutunun kenarı belli olmasın diye zemin eşitleniyor. */
    background: #000;
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .jewelry-visual img {
    width: 100%;
    max-width: 320px;
    height: auto;
  }

  .jewelry-copy {
    padding: clamp(2rem, 4vw, 3.2rem);
  }

  .jewelry-copy h2 {
    margin-bottom: 0.4em;
  }

  .jewelry-copy p {
    max-width: 46ch;
  }

  .jewelry-copy p + p {
    margin-top: 0.9em;
  }

  .jewelry-copy .btn {
    margin-top: 1.6rem;
  }

  .final-cta {
    padding-bottom: clamp(4rem, 10vw, 8rem);
  }

  .cta-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 2rem;
    padding: clamp(2rem, 4vw, 3.5rem);
  }

  .cta-box h2 {
    margin-bottom: 0.3em;
  }

  .cta-box p {
    margin: 0;
    max-width: 44ch;
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 860px) {
    .pillar-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .service-grid {
      grid-template-columns: 1fr;
    }
    .artist-inner {
      grid-template-columns: 1fr;
    }
    .artist-photo {
      max-width: 300px;
    }
    .preview-inner {
      grid-template-columns: 1fr;
    }
    .preview-visual {
      min-height: 180px;
      order: -1;
    }
    .jewelry-inner {
      grid-template-columns: 1fr;
    }
    .jewelry-visual {
      min-height: 180px;
    }
  }
</style>
