---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Sayfa Bulunamadı"
  description="Aradığınız sayfa bulunamadı."
  path="/404"
  noindex={true}
>
  <section class="not-found">
    <div class="container">
      <img src="/brand/logo-mark.png" alt="Black Ink Art" width="200" height="93" class="logo" />
      <p class="code">404</p>
      <h1>Bu sayfa mürekkep tutmamış.</h1>
      <p>Aradığınız sayfa taşınmış veya hiç var olmamış olabilir.</p>
      <div class="actions">
        <a href="/" class="btn btn-primary">Ana Sayfaya Dön</a>
        <a href="/portfolyo" class="btn btn-outline">Portfolyoyu Gör</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-block: 6rem 4rem;
  }

  .logo {
    height: 40px;
    width: auto;
    margin: 0 auto 2rem;
    opacity: 0.8;
  }

  .code {
    font-family: var(--font-display);
    font-size: 5rem;
    color: var(--color-gold);
    line-height: 1;
    margin-bottom: 0.2em;
  }

  .not-found p {
    max-width: 46ch;
    margin-inline: auto;
  }

  .actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }
</style>
