---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { tattooPricing, KDV_NOTE } from '../../data/prices';
---

<BaseLayout
  title="Dövme Fiyatları"
  description="Ankara Bahçelievler Black Ink Art dövme fiyatları: makine açılış ücreti, minimal dövme paketleri ve detaylı dövme fiyatlandırması."
  path="/dovme/fiyatlar"
>
  <section class="section-tight">
    <div class="container narrow">
      <Breadcrumbs items={[{ label: 'Dövme', href: '/dovme' }, { label: 'Fiyatlar' }]} />
      <p class="eyebrow">Dövme</p>
      <h1>Dövme Fiyatları</h1>
      <div class="gold-rule"></div>

      <div class="opening-price surface" data-reveal>
        <span class="label">Makine Açılış Fiyatı</span>
        <span class="value">{tattooPricing.openingPrice.toLocaleString('tr-TR')} {tattooPricing.currency}</span>
      </div>

      <ul class="notes" data-reveal>
        {tattooPricing.notes.map((n) => <li>{n}</li>)}
      </ul>

      <p class="kdv-note">{KDV_NOTE}</p>

      <div class="cta surface" data-reveal>
        <div>
          <h3>Net fiyat teklifi ister misiniz?</h3>
          <p>Tasarımınızın fotoğrafını veya fikrinizi paylaşın, size özel fiyat verelim.</p>
        </div>
        <div class="cta-actions">
          <a href="/randevu" class="btn btn-primary">Randevu Al</a>
          <a href="/hakkimizda-iletisim" class="btn btn-outline">İletişime Geç</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 760px;
  }

  .opening-price {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 1.6rem 1.8rem;
    margin: 2rem 0 1.5rem;
  }

  .opening-price .label {
    font-size: 0.9rem;
    color: var(--color-ivory-dim);
  }

  .opening-price .value {
    font-family: var(--font-display);
    font-size: 2.2rem;
    color: var(--color-gold);
  }

  .notes {
    color: var(--color-ivory-dim);
    padding-left: 1.2em;
  }

  .notes li {
    margin-bottom: 0.6em;
  }

  .kdv-note {
    font-size: 0.8rem;
    color: var(--color-ivory-faint);
    font-style: italic;
    margin-top: -0.5rem;
  }

  .cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding: 2rem;
    margin-top: 2.5rem;
  }

  .cta h3 {
    margin-bottom: 0.3em;
  }

  .cta p {
    margin: 0;
  }

  .cta-actions {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
</style>
