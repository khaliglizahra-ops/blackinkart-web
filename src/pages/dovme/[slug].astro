---
import GuidePage from '../../components/pages/GuidePage.astro';
import { getLocalizedCollection, cleanSlug } from '../../i18n/content';

export async function getStaticPaths() {
  const out = [];
  for (const lang of ['tr'.split(',')].flat()) {
    const guides = await getLocalizedCollection('dovme-rehberi', lang as 'tr' | 'en');
    guides.forEach((entry, i) => {
      const slug = cleanSlug(entry.slug);
      const at = (n: number) => {
        const e = guides[n];
        return e ? { title: e.data.title, slug: cleanSlug(e.slug) } : null;
      };
      out.push({
        params: { slug },
        props: {
          entry,
          slug,
          lang,
          prev: i > 0 ? at(i - 1) : null,
          next: i < guides.length - 1 ? at(i + 1) : null,
          showPainMap: entry.slug === 'dovme-acisi-ve-hassasiyet',
        },
      });
    });
  }
  return out.filter((p) => p.props.lang === 'tr');
}

const props = Astro.props;
---

<GuidePage {...props} hub="dovme" />
