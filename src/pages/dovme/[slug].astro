---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideArticle from '../../components/GuideArticle.astro';
import BodyPainMap from '../../components/BodyPainMap.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const guides = (await getCollection('dovme-rehberi')).sort((a, b) => a.data.order - b.data.order);
  return guides.map((entry, i) => ({
    params: { slug: entry.slug },
    props: {
      entry,
      prev: i > 0 ? guides[i - 1] : null,
      next: i < guides.length - 1 ? guides[i + 1] : null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  dateModified: entry.data.updatedAt,
  author: { '@type': 'Person', name: site.founder },
  publisher: { '@type': 'Organization', name: site.name },
};
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  path={`/dovme/${entry.slug}`}
  jsonLd={jsonLd}
>
  <GuideArticle
    hubLabel="Dövme Rehberi"
    hubHref="/dovme"
    title={entry.data.title}
    updatedAt={entry.data.updatedAt}
    heroImage={entry.data.heroImage}
    heroArt={entry.data.heroArt}
    heroSeed={entry.data.heroSeed}
    prev={prev ? { title: prev.data.title, href: `/dovme/${prev.slug}` } : null}
    next={next ? { title: next.data.title, href: `/dovme/${next.slug}` } : null}
  >
    <Content />
    {entry.slug === 'dovme-acisi-ve-hassasiyet' && <BodyPainMap />}
  </GuideArticle>
</BaseLayout>
