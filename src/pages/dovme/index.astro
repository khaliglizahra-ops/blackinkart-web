---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideHero from '../../components/GuideHero.astro';
import ArtBackground from '../../components/ArtBackground.astro';
import { thumb } from '../../data/images';

const guides = (await getCollection('dovme-rehberi')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Dövme Rehberi ve Bilgi Merkezi"
  description="Dövme stilleri, teknikleri, uygulama aşamaları, bakımı ve fiyatları hakkında Black Ink Art'ın kapsamlı dövme rehberi."
  path="/dovme"
>
  <GuideHero
    eyebrow="Dövme"
    title="Dövme Rehberi"
    breadcrumbs={[{ label: 'Dövme' }]}
    image="/images/portfolyo/top30/top-11.jpg"
  />

  <section class="section-tight hub-hero">
    <div class="container">
      <p class="lead">
        Kalıcı dövme kararınızı bilinçli vermeniz için hazırladığımız rehberler: stiller, teknikler,
        uygulama aşamaları, bakım ve daha fazlası.
      </p>
      <div class="hub-actions">
        <a href="/dovme/fiyatlar" class="btn btn-primary">Fiyatları Gör</a>
        <a href="/portfolyo" class="btn btn-outline">Portfolyoyu İncele</a>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>Rehberler</h2>
      <div class="guide-grid">
        {guides.map((g) => (
          <a href={`/dovme/${g.slug}`} class="guide-card surface" data-reveal>
            <div class="thumb">
              {g.data.heroImage ? (
                <img src={thumb(g.data.heroImage)} alt="" loading="lazy" />
              ) : (
                <ArtBackground variant={g.data.heroArt ?? 'flow'} seed={g.data.heroSeed ?? g.data.order} />
              )}
              <span class="index">0{g.data.order}</span>
            </div>
            <div class="card-body">
              <h3>{g.data.title}</h3>
              <p>{g.data.description}</p>
              <span class="read-more">Devamını Oku →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hub-hero .lead {
    max-width: 62ch;
    font-size: 1.05rem;
  }

  .hub-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  .guide-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .guide-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: border-color var(--dur-fast), transform var(--dur-fast) var(--ease-out);
  }

  .guide-card:hover {
    border-color: var(--color-gold-35);
    transform: translateY(-3px);
  }

  .thumb {
    position: relative;
    height: 150px;
    overflow: hidden;
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease-out);
  }

  .guide-card:hover .thumb img {
    transform: scale(1.06);
  }

  .thumb::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(0, 0, 0, 0.6));
  }

  .index {
    position: absolute;
    left: 1rem;
    bottom: 0.7rem;
    z-index: 1;
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--color-gold-bright);
  }

  .card-body {
    padding: 1.4rem 1.6rem 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex-grow: 1;
  }

  .guide-card h3 {
    margin-bottom: 0.2em;
    font-size: 1.25rem;
  }

  .guide-card p {
    font-size: 0.9rem;
    flex-grow: 1;
  }

  .read-more {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-gold);
  }
</style>
