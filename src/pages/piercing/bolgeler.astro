---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { allPiercingPriceTables, startingPrice } from '../../data/prices';

const areas = (await getCollection('piercing-bolgeleri')).sort((a, b) => a.data.order - b.data.order);

function priceFor(slug: string) {
  const table = allPiercingPriceTables.find((t) => t.slug === slug);
  if (!table) return null;
  return startingPrice(table);
}
---

<BaseLayout
  title="Piercing Bölgeleri Karşılaştırma Tablosu"
  description="Kulak, burun, dudak, dil, göbek ve daha fazlası — piercing bölgelerini iyileşme süresi, acı seviyesi ve başlangıç fiyatına göre karşılaştırın."
  path="/piercing/bolgeler"
>
  <section class="section-tight">
    <div class="container narrow">
      <Breadcrumbs items={[{ label: 'Piercing', href: '/piercing' }, { label: 'Bölgeler' }]} />
      <p class="eyebrow">Piercing</p>
      <h1>Bölgelere Göre Karşılaştırma</h1>
      <p class="lead">
        Hangi bölgede piercing yaptıracağınıza karar vermeden önce iyileşme süresi, acı seviyesi ve
        başlangıç fiyatını tek bakışta karşılaştırın.
      </p>
      <div class="gold-rule"></div>

      <div class="scroll surface" data-reveal>
        <table>
          <thead>
            <tr>
              <th scope="col">Bölge</th>
              <th scope="col">İyileşme Süresi</th>
              <th scope="col">Acı Seviyesi</th>
              <th scope="col">Başlangıç Fiyatı</th>
            </tr>
          </thead>
          <tbody>
            {areas.map((area) => {
              const price = priceFor(area.data.priceSlug);
              return (
                <tr>
                  <th scope="row"><a href={`/piercing/${area.slug}`}>{area.data.title}</a></th>
                  <td>{area.data.healingTime}</td>
                  <td>{area.data.painLevel}</td>
                  <td class="price">{price ? `${price.toLocaleString('tr-TR')} TL'den` : 'İletişime geçin'}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <p class="kdv-note">Fiyatlar cerrahi çelik başlangıç fiyatıdır; taşlı/ring ve titanyum seçenekleri için bkz. <a href="/piercing/fiyatlar">Piercing Fiyatları</a>.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 820px;
  }

  .lead {
    max-width: 60ch;
  }

  .scroll {
    overflow-x: auto;
  }

  table {
    min-width: 560px;
  }

  th[scope='row'] a {
    color: var(--color-ivory);
    font-weight: 600;
  }

  th[scope='row'] a:hover {
    color: var(--color-gold);
  }

  .kdv-note {
    font-size: 0.82rem;
    color: var(--color-ivory-faint);
    margin-top: 1rem;
  }

  .kdv-note a {
    color: var(--color-gold);
  }
</style>
