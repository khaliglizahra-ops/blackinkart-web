---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PriceTable from '../../components/PriceTable.astro';
import { allPiercingPriceTables, KDV_NOTE, MULTI_PIERCING_NOTE } from '../../data/prices';
---

<BaseLayout
  title="Piercing Fiyatları"
  description="Ankara Bahçelievler Black Ink Art piercing fiyat listesi: kulak, burun, dudak, dil ve diğer tüm piercing çeşitleri için cerrahi çelik, taşlı ve titanyum fiyatları."
  path="/piercing/fiyatlar"
>
  <section class="section-tight">
    <div class="container narrow">
      <Breadcrumbs items={[{ label: 'Piercing', href: '/piercing' }, { label: 'Fiyatlar' }]} />
      <p class="eyebrow">Piercing</p>
      <h1>Piercing Fiyat Listesi</h1>
      <p class="lead">
        Tüm fiyatlarımız üç malzeme seçeneğine göre listelenmiştir: cerrahi çelik, taşlı/ring ve titanyum.
        İlk delimde biyo-uyumlu titanyum önerimizdir — bkz.
        <a href="/piercing/piercing-malzemeleri">Piercing Malzemeleri</a>.
      </p>
      <div class="gold-rule"></div>

      {allPiercingPriceTables.map((table) => <PriceTable table={table} />)}

      <p class="note">{MULTI_PIERCING_NOTE}</p>
      <p class="kdv-note">{KDV_NOTE}</p>

      <div class="cta surface" data-reveal>
        <div>
          <h3>Net fiyat mı gerekiyor?</h3>
          <p>Düşündüğünüz piercingi bize iletin, hemen bilgi verelim.</p>
        </div>
        <div class="cta-actions">
          <a href="/randevu" class="btn btn-primary">Randevu Al</a>
          <a href="/hakkimizda-iletisim" class="btn btn-outline">İletişime Geç</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 820px;
  }

  .lead {
    max-width: 60ch;
  }

  .lead a {
    color: var(--color-gold);
  }

  .note {
    font-size: 0.85rem;
    color: var(--color-ivory-dim);
  }

  .kdv-note {
    font-size: 0.8rem;
    color: var(--color-ivory-faint);
    font-style: italic;
  }

  .cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding: 2rem;
    margin-top: 1.5rem;
  }

  .cta h3 {
    margin-bottom: 0.3em;
  }

  .cta p {
    margin: 0;
  }

  .cta-actions {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
</style>
