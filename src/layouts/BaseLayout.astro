---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Lightbox from '../components/Lightbox.astro';
import SEO from '../components/SEO.astro';
import { langFromPath, LANG_LABELS } from '../i18n/config';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, path, image, noindex, jsonLd } = Astro.props;

// Dil, prop olarak her sayfadan taşınmak yerine adresten okunuyor; alt
// bileşenler de aynı şekilde kendileri buluyor. Böylece iki dil eklemek
// sayfa dosyalarında imza değişikliği gerektirmedi.
const lang = langFromPath(Astro.url.pathname);
---

<!doctype html>
<html lang={LANG_LABELS[lang].htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/png" href="/brand/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/brand/favicon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <SEO title={title} description={description} path={path} image={image} noindex={noindex} jsonLd={jsonLd} />
    <ClientRouter />
    <!-- Netlify Identity daveti / parola sıfırlama bağlantısı ana sayfaya
         `#invite_token=...` ya da `#recovery_token=...` ile düşüyor. Widget bu
         belirteci kendisi okuyup doğru pencereyi (parola belirleme) açar —
         burada `open()` çağırmak onu düz "giriş" ekranına düşürüyordu. Bu
         yüzden yalnızca yüklüyor, açmayı ona bırakıyoruz.
         Koşullu yükleme: belirteç yoksa bu ~100 KB betik hiç indirilmiyor. -->
    <script is:inline>
      if (/[#&](invite_token|recovery_token|confirmation_token|email_change_token)=/.test(window.location.hash)) {
        const s = document.createElement('script');
        s.src = 'https://identity.netlify.com/v1/netlify-identity-widget.js';
        s.onload = () => {
          const id = window.netlifyIdentity;
          if (!id) return;
          id.on('login', () => { window.location.href = '/admin/'; });
        };
        document.head.appendChild(s);
      }
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
    <Lightbox />
    <script>
      function initReveal() {
        const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
        if (!('IntersectionObserver' in window)) {
          items.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );
        items.forEach((el, i) => {
          el.style.transitionDelay = `${Math.min(i % 6, 5) * 70}ms`;
          observer.observe(el);
        });
      }
      initReveal();
      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>
