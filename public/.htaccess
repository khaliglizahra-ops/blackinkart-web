# Black Ink Art — Hostinger (Apache) ayarları.
# Netlify'daki netlify.toml'un karşılığı: temiz adresler, /admin, önbellek başlıkları.

Options -Indexes
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS ve www'ye yönlendir (sitenin asıl adresi https://www.blackinkart.com.tr).
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(blackinkart\.com\.tr)$ [NC]
  RewriteRule ^ https://www.%1%{REQUEST_URI} [R=301,L]

  # Yönetim paneli: config.yml göreli yüklendiği için /admin sonu eğik çizgili olmalı.
  RewriteRule ^admin$ /admin/ [R=301,L]

  # /api kendi .htaccess'iyle yönetiliyor.
  RewriteRule ^api(/|$) - [L]

  # Diğer sayfalar eğik çizgisiz (astro.config: trailingSlash 'never').
  RewriteCond %{REQUEST_URI} !^/admin/
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # /sayfa -> /sayfa/index.html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ /$1/index.html [L]

  # /sayfa -> /sayfa.html (varsa)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ /$1.html [L]
</IfModule>

# Önbellek / noindex başlıkları ilgili klasörlerdeki .htaccess dosyalarında
# (admin/, _astro/, models/) — LiteSpeed <If> bloklarını desteklemiyor.


<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
  AddType model/gltf+json .gltf
  AddType image/avif .avif
  AddType image/webp .webp
</IfModule>
