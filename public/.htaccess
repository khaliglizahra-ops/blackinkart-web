# Black Ink Art — Hostinger (Apache) ayarları.
# Netlify'daki netlify.toml'un karşılığı: temiz adresler, /admin, önbellek başlıkları.

Options -Indexes
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # FTP dağıtım eylemi sunucunun köküne tüm dosyaların envanterini içeren bir
  # durum dosyası bırakıyor; herkese açık kalmasın. (Dağıtım FTP ile çalıştığı
  # için HTTP'den engellemek dağıtımı etkilemez.)
  RewriteRule ^\.ftp-deploy-sync-state\.json$ - [F,L]

  # HTTPS ve www'ye yönlendir (sitenin asıl adresi https://www.blackinkart.com.tr).
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(blackinkart\.com\.tr)$ [NC]
  RewriteRule ^ https://www.%1%{REQUEST_URI} [R=301,L]

  # Yönetim paneli: config.yml göreli yüklendiği için /admin sonu eğik çizgili olmalı.
  RewriteRule ^admin$ /admin/ [R=301,L]

  # /api kendi .htaccess'iyle yönetiliyor.
  RewriteRule ^api(/|$) - [L]

  # Diğer sayfalar eğik çizgisiz (astro.config: trailingSlash 'never').
  RewriteCond %{REQUEST_URI} !^/admin/
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # /sayfa -> /sayfa/index.html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ /$1/index.html [L]

  # /sayfa -> /sayfa.html (varsa)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ /$1.html [L]
</IfModule>

# Önbellek / noindex başlıkları ilgili klasörlerdeki .htaccess dosyalarında
# (admin/, _astro/, models/) — LiteSpeed <If> bloklarını desteklemiyor.


<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
  AddType model/gltf+json .gltf
  AddType image/avif .avif
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
</IfModule>

# Temel güvenlik başlıkları — tarayıcı tarafı koruma.
# İçerik Güvenliği Politikası (CSP) buraya değil, her sayfanın <head>'ine
# <meta> olarak (src/layouts/BaseLayout.astro) konuyor: /admin paneli unpkg'den
# Decap CMS yüklüyor ve farklı bir politika ister; başlık olarak tüm siteye
# koyulsaydı paneli bozardı. Meta etiketinde olmayan `frame-ancestors`
# işini aşağıdaki X-Frame-Options görüyor.
# Permissions-Policy: site kamera, mikrofon, konum, ödeme vb. hiçbir cihaz
# özelliğini kullanmıyor; kapatmak, sayfaya sızan bir betiğin de kullanmasını önler.
# HTML sayfaları her seferinde sunucuya sorulsun (no-cache = önbellekte tut ama kullanmadan
# önce doğrula). Başlık olmadığında tarayıcılar sayfayı sezgisel olarak saatlerce
# önbellekten gösterebiliyor; bir düzeltme yayınlansa bile ziyaretçi eski sayfayı görüyordu.
# Görseller, _astro betikleri ve yazı tipleri kendi klasörlerinin kuralını izlemeye devam eder.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=15768000; includeSubDomains"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), accelerometer=(), gyroscope=(), magnetometer=(), interest-cohort=()"
</IfModule>
